              "tgtId": "56002011007"
            },
            {
              "ru": 6,
              "gr": 6,
              "srcId": "n56002011007",
              "tgtId": "56002011008"
            }
          ]
        },
        {
          "n": 12,
          "text": "научающая нас, чтобы мы, отвергнув нечестие и мирские похоти, целомудренно, праведно и благочестиво жили в нынешнем веке,",
          "alignment": [
            {
              "ru": 0,
              "gr": 0,
              "srcId": "n56002012001",
              "tgtId": "56002012001"
            },
            {
              "ru": 7,
              "gr": 3,
              "srcId": "n56002012004",
