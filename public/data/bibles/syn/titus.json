            },
            {
              "ru": 11,
              "gr": 8,
              "srcId": "n56002015009",
              "tgtId": "56002015014"
            }
          ]
        }
      ]
    },
    {
      "n": 3,
      "verses": [
        {
          "n": 1,
          "text": "Напоминай им повиноваться и покоряться начальству и властям, быть готовыми на всякое доброе дело,",
          "alignment": [
            {
              "ru": 0,
              "gr": 0,
              "srcId": "n56003001001",
              "tgtId": "56003001001"
            },
            {
              "ru": 2,
              "gr": 4,
              "srcId": "n56003001005",
              "tgtId": "56003001003"
            },
            {
              "ru": 4,
              "gr": 5,
              "srcId": "n56003001006",
              "tgtId": "56003001005"
            },
            {
              "ru": 5,
              "gr": 2,
              "srcId": "n56003001003",
              "tgtId": "56003001006"
            },
            {
              "ru": 9,
              "gr": 3,
              "srcId": "n56003001004",
              "tgtId": "56003001011"
            },
            {
              "ru": 11,
              "gr": 10,
              "srcId": "n56003001011",
              "tgtId": "56003001013"
            },
            {
              "ru": 13,
              "gr": 7,
              "srcId": "n56003001008",
              "tgtId": "56003001015"
            }
          ]
        },
        {
          "n": 2,
          "text": "никого не злословить, быть не сварливыми, но тихими, и оказывать всякую кротость ко всем человекам.",
          "alignment": [
            {
              "ru": 4,
              "gr": 1,
              "srcId": "n56003002002",
              "tgtId": "56003002006"
            },
            {
              "ru": 8,
              "gr": 2,
              "srcId": "n56003002003",
              "tgtId": "56003002012"
            },
            {
              "ru": 13,
              "gr": 4,
              "srcId": "n56003002005",
              "tgtId": "56003002017"
            }
          ]
        },
        {
          "n": 3,
          "text": "Ибо и мы были некогда несмысленны, непокорны, заблуждшие, были рабы похотей и различных удовольствий, жили в злобе и зависти, были гнусны, ненавидели друг друга.",
          "alignment": [
            {
              "ru": 4,
              "gr": 2,
              "srcId": "n56003003003",
              "tgtId": "56003003005"
            },
            {
              "ru": 9,
              "gr": 6,
              "srcId": "n56003003007",
              "tgtId": "56003003013"
            },
            {
              "ru": 13,
              "gr": 7,
              "srcId": "n56003003008",
              "tgtId": "56003003017"
            },
            {
              "ru": 14,
              "gr": 8,
              "srcId": "n56003003009",
              "tgtId": "56003003019"
            },
            {
              "ru": 15,
              "gr": 9,
              "srcId": "n56003003010",
              "tgtId": "56003003020"
            },
            {
              "ru": 17,
              "gr": 12,
              "srcId": "n56003003013",
              "tgtId": "56003003022"
            },
            {
              "ru": 20,
              "gr": 11,
