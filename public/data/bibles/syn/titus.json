              "tgtId": "56002010020"
            }
          ]
        },
        {
          "n": 11,
          "text": "Ибо явилась благодать Божия, спасительная для всех человеков,",
          "alignment": [
            {
              "ru": 1,
              "gr": 0,
              "srcId": "n56002011001",
              "tgtId": "56002011002"
            },
            {
              "ru": 2,
              "gr": 3,
              "srcId": "n56002011004",
