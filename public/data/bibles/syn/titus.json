              "tgtId": "56003003026"
            },
            {
              "ru": 22,
              "gr": 14,
              "srcId": "n56003003015",
              "tgtId": "56003003029"
            }
          ]
        },
        {
          "n": 4,
          "text": "Когда же явилась благодать и человеколюбие Спасителя нашего, Бога,",
          "alignment": [
            {
              "ru": 2,
              "gr": 7,
              "srcId": "n56003004008",
              "tgtId": "56003004003"
            },
            {
              "ru": 3,
              "gr": 3,
              "srcId": "n56003004004",
              "tgtId": "56003004004"
            },
            {
              "ru": 5,
              "gr": 6,
              "srcId": "n56003004007",
              "tgtId": "56003004006"
            },
            {
              "ru": 6,
              "gr": 9,
              "srcId": "n56003004010",
              "tgtId": "56003004007"
            }
          ]
        },
        {
          "n": 5,
          "text": "Он спас нас не по делам праведности, которые бы мы сотворили, а по Своей милости, банею возрождения и обновления Святым Духом,",
          "alignment": [
            {
              "ru": 1,
              "gr": 14,
              "srcId": "n56003005015",
              "tgtId": "56003005002"
            },
            {
              "ru": 5,
              "gr": 2,
              "srcId": "n56003005003",
              "tgtId": "56003005006"
            },
            {
              "ru": 14,
              "gr": 7,
              "srcId": "n56003005008",
              "tgtId": "56003005017"
            },
            {
              "ru": 20,
              "gr": 13,
              "srcId": "n56003005014",
              "tgtId": "56003005024"
            }
          ]
        },
        {
          "n": 6,
          "text": "Которого излил на нас обильно через Иисуса Христа, Спасителя нашего,",
          "alignment": [
            {
              "ru": 1,
              "gr": 1,
              "srcId": "n56003006002",
              "tgtId": "56003006002"
            },
            {
              "ru": 4,
              "gr": 4,
              "srcId": "n56003006005",
              "tgtId": "56003006005"
            },
            {
              "ru": 6,
              "gr": 6,
              "srcId": "n56003006007",
              "tgtId": "56003006007"
            },
            {
              "ru": 9,
              "gr": 7,
              "srcId": "n56003006008",
              "tgtId": "56003006011"
            }
          ]
        },
        {
          "n": 7,
          "text": "чтобы, оправдавшись Его благодатью, мы по упованию соделались наследниками вечной жизни.",
          "alignment": [
            {
              "ru": 7,
              "gr": 4,
              "srcId": "n56003007005",
              "tgtId": "56003007010"
            },
            {
              "ru": 10,
              "gr": 8,
              "srcId": "n56003007009",
              "tgtId": "56003007013"
            }
          ]
        },
        {
          "n": 8,
          "text": "Слово это верно; и я желаю, чтобы ты подтверждал о сем, дабы уверовавшие в Бога старались быть прилежными к добрым делам: это хорошо и полезно человекам.",
          "alignment": [
            {
              "ru": 0,
              "gr": 2,
              "srcId": "n56003008003",
              "tgtId": "56003008001"
            },
            {
              "ru": 2,
              "gr": 0,
              "srcId": "n56003008001",
              "tgtId": "56003008003"
            },
            {
              "ru": 7,
              "gr": 6,
              "srcId": "n56003008007",
              "tgtId": "56003008010"
            },
            {
              "ru": 10,
              "gr": 8,
              "srcId": "n56003008009",
              "tgtId": "56003008013"
            },
            {
              "ru": 16,
              "gr": 15,
              "srcId": "n56003008016",
              "tgtId": "56003008020"
            },
            {
              "ru": 19,
              "gr": 10,
              "srcId": "n56003008011",
              "tgtId": "56003008023"
            },
            {
              "ru": 22,
              "gr": 11,
              "srcId": "n56003008012",
              "tgtId": "56003008027"
            }
          ]
        },
        {
          "n": 9,
          "text": "Глупых же состязаний и родословий, и споров и распрей о законе удаляйся, ибо они бесполезны и суетны.",
          "alignment": [
            {
              "ru": 0,
              "gr": 0,
              "srcId": "n56003009001",
              "tgtId": "56003009001"
            },
            {
              "ru": 2,
              "gr": 2,
              "srcId": "n56003009003",
              "tgtId": "56003009003"
            },
            {
              "ru": 6,
              "gr": 4,
              "srcId": "n56003009005",
              "tgtId": "56003009008"
            },
            {
              "ru": 8,
              "gr": 6,
              "srcId": "n56003009007",
              "tgtId": "56003009010"
            },
            {
              "ru": 10,
              "gr": 8,
              "srcId": "n56003009009",
              "tgtId": "56003009012"
            },
            {
              "ru": 15,
              "gr": 10,
              "srcId": "n56003009011",
              "tgtId": "56003009018"
            }
          ]
        },
        {
          "n": 10,
          "text": "Еретика, после первого и второго вразумления, отвращайся,",
          "alignment": [
            {
              "ru": 2,
              "gr": 0,
              "srcId": "n56003010001",
              "tgtId": "56003010004"
            },
            {
              "ru": 4,
              "gr": 3,
              "srcId": "n56003010004",
              "tgtId": "56003010006"
            }
          ]
        },
        {
          "n": 11,
          "text": "зная, что таковой развратился и грешит, будучи самоосужден.",
          "alignment": [
            {
              "ru": 4,
              "gr": 4,
              "srcId": "n56003011005",
              "tgtId": "56003011006"
            },
            {
              "ru": 5,
              "gr": 2,
              "srcId": "n56003011003",
              "tgtId": "56003011007"
            }
          ]
        },
        {
          "n": 12,
          "text": "Когда пришлю к тебе Артему или Тихика, поспеши придти ко мне в Никополь, ибо я положил там провести зиму.",
          "alignment": [
            {
              "ru": 1,
              "gr": 1,
              "srcId": "n56003012002",
              "tgtId": "56003012002"
            },
            {
              "ru": 4,
              "gr": 2,
              "srcId": "n56003012003",
              "tgtId": "56003012005"
            },
            {
              "ru": 9,
              "gr": 7,
              "srcId": "n56003012008",
              "tgtId": "56003012011"
            },
            {
              "ru": 13,
              "gr": 12,
              "srcId": "n56003012013",
              "tgtId": "56003012016"
            },
            {
              "ru": 17,
              "gr": 15,
              "srcId": "n56003012016",
              "tgtId": "56003012020"
            },
            {
              "ru": 18,
              "gr": 13,
              "srcId": "n56003012014",
              "tgtId": "56003012021"
            }
          ]
        },
        {
          "n": 13,
          "text": "Зину законника и Аполлоса позаботься отправить так, чтобы у них ни в чем не было недостатка.",
          "alignment": [
            {
              "ru": 0,
              "gr": 0,
              "srcId": "n56003013001",
              "tgtId": "56003013001"
            },
            {
              "ru": 1,
              "gr": 2,
              "srcId": "n56003013003",
              "tgtId": "56003013002"
            },
            {
              "ru": 3,
              "gr": 4,
              "srcId": "n56003013005",
              "tgtId": "56003013004"
            },
            {
              "ru": 4,
              "gr": 5,
              "srcId": "n56003013006",
              "tgtId": "56003013005"
            },
            {
              "ru": 5,
              "gr": 6,
              "srcId": "n56003013007",
              "tgtId": "56003013006"
            }
          ]
        },
        {
          "n": 14,
          "text": "Пусть и наши учатся упражняться в добрых делах, в удовлетворении необходимым нуждам, дабы не были бесплодны.",
          "alignment": [
            {
              "ru": 2,
              "gr": 4,
              "srcId": "n56003014005",
              "tgtId": "56003014003"
            },
            {
              "ru": 3,
              "gr": 0,
              "srcId": "n56003014001",
              "tgtId": "56003014004"
            },
            {
              "ru": 4,
              "gr": 7,
              "srcId": "n56003014008",
              "tgtId": "56003014005"
            },
            {
              "ru": 6,
              "gr": 5,
              "srcId": "n56003014006",
              "tgtId": "56003014007"
            },
            {
              "ru": 15,
              "gr": 11,
              "srcId": "n56003014012",
              "tgtId": "56003014018"
            }
          ]
        },
        {
          "n": 15,
          "text": "Приветствуют тебя все находящиеся со мною. Приветствуй любящих нас в вере. Благодать со всеми вами. Аминь.",
