              "srcId": "n56002013015",
              "tgtId": "56002013012"
            }
          ]
        },
        {
          "n": 14,
          "text": "Который дал Себя за нас, чтобы избавить нас от всякого беззакония и очистить Себе народ особенный, ревностный к добрым делам.",
          "alignment": [
            {
              "ru": 1,
              "gr": 1,
              "srcId": "n56002014002",
              "tgtId": "56002014002"
            },
            {
              "ru": 2,
              "gr": 2,
              "srcId": "n56002014003",
              "tgtId": "56002014003"
            },
            {
              "ru": 8,
              "gr": 6,
              "srcId": "n56002014007",
              "tgtId": "56002014010"
            },
            {
              "ru": 11,
              "gr": 9,
              "srcId": "n56002014010",
              "tgtId": "56002014013"
            },
            {
              "ru": 12,
              "gr": 10,
              "srcId": "n56002014011",
              "tgtId": "56002014014"
            },
            {
              "ru": 14,
              "gr": 12,
              "srcId": "n56002014013",
              "tgtId": "56002014016"
            },
            {
              "ru": 15,
              "gr": 13,
              "srcId": "n56002014014",
