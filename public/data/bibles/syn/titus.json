            },
            {
              "ru": 8,
              "gr": 5,
              "srcId": "n56002012006",
              "tgtId": "56002012011"
            },
            {
              "ru": 9,
              "gr": 8,
              "srcId": "n56002012009",
              "tgtId": "56002012013"
            },
            {
              "ru": 12,
              "gr": 9,
              "srcId": "n56002012010",
              "tgtId": "56002012017"
            },
            {
              "ru": 16,
              "gr": 10,
              "srcId": "n56002012011",
              "tgtId": "56002012021"
            }
          ]
        },
        {
          "n": 13,
          "text": "ожидая блаженного упования и явления славы великого Бога и Спасителя нашего Иисуса Христа,",
          "alignment": [
            {
              "ru": 0,
              "gr": 0,
              "srcId": "n56002013001",
              "tgtId": "56002013001"
            },
            {
              "ru": 1,
              "gr": 2,
              "srcId": "n56002013003",
              "tgtId": "56002013002"
            },
            {
              "ru": 2,
              "gr": 3,
              "srcId": "n56002013004",
              "tgtId": "56002013003"
            },
            {
              "ru": 4,
              "gr": 5,
              "srcId": "n56002013006",
              "tgtId": "56002013005"
            },
            {
              "ru": 5,
              "gr": 7,
