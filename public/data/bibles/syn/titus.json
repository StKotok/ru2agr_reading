            },
            {
              "ru": 19,
              "gr": 15,
              "srcId": "n56002014016",
              "tgtId": "56002014022"
            }
          ]
        },
        {
          "n": 15,
          "text": "Сие говори, увещевай и обличай со всякою властью, чтобы никто не пренебрегал тебя.",
          "alignment": [
            {
              "ru": 3,
              "gr": 1,
              "srcId": "n56002015002",
              "tgtId": "56002015005"
            },
            {
