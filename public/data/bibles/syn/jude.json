              "tgtId": "65001018009"
            },
            {
              "ru": 8,
              "gr": 5,
              "srcId": "n65001018006",
              "tgtId": "65001018010"
            },
            {
              "ru": 12,
              "gr": 7,
              "srcId": "n65001018008",
              "tgtId": "65001018015"
            },
            {
              "ru": 13,
              "gr": 12,
              "srcId": "n65001018013",
              "tgtId": "65001018016"
            }
          ]
        },
        {
          "n": 19,
          "text": "Это люди, отделяющие себя (от единства веры), душевные, не имеющие духа."
        },
        {
          "n": 20,
          "text": "А вы, возлюбленные, назидая себя на святейшей вере вашей, молясь Духом Святым,",
