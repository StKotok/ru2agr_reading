            }
          ]
        }
      ]
    },
    {
      "n": 3,
      "verses": [
        {
          "n": 1,
          "text": "Итак молитесь за нас, братия, чтобы слово Господне распространялось и прославлялось, как и у вас,",
          "alignment": [
            {
              "ru": 0,
              "gr": 1,
              "srcId": "n53003001002",
              "tgtId": "53003001001"
            },
            {
              "ru": 1,
              "gr": 2,
              "srcId": "n53003001003",
              "tgtId": "53003001003"
            },
            {
              "ru": 8,
              "gr": 3,
              "srcId": "n53003001004",
              "tgtId": "53003001012"
            },
            {
              "ru": 10,
              "gr": 8,
              "srcId": "n53003001009",
              "tgtId": "53003001014"
            },
            {
              "ru": 11,
              "gr": 11,
              "srcId": "n53003001012",
              "tgtId": "53003001016"
            }
          ]
        },
        {
          "n": 2,
          "text": "и чтобы нам избавиться от беспорядочных и лукавых людей, ибо не во всех вера.",
          "alignment": [
            {
              "ru": 3,
              "gr": 2,
              "srcId": "n53003002003",
              "tgtId": "53003002004"
            },
            {
              "ru": 5,
              "gr": 5,
              "srcId": "n53003002006",
              "tgtId": "53003002006"
            },
            {
              "ru": 7,
              "gr": 7,
              "srcId": "n53003002008",
              "tgtId": "53003002008"
            }
          ]
        },
        {
          "n": 3,
          "text": "Но верен Господь, Который утвердит вас и сохранит от лукавого.",
          "alignment": [
            {
              "ru": 1,
              "gr": 0,
              "srcId": "n53003003001",
              "tgtId": "53003003002"
            },
            {
              "ru": 4,
              "gr": 4,
              "srcId": "n53003003005",
              "tgtId": "53003003006"
            },
            {
              "ru": 6,
              "gr": 6,
              "srcId": "n53003003007",
              "tgtId": "53003003008"
            },
            {
              "ru": 9,
              "gr": 9,
              "srcId": "n53003003010",
              "tgtId": "53003003011"
            }
          ]
        },
        {
          "n": 4,
          "text": "Мы уверены о вас в Господе, что вы исполняете и будете исполнять то, что мы вам повелеваем.",
          "alignment": [
            {
              "ru": 1,
              "gr": 0,
              "srcId": "n53003004001",
              "tgtId": "53003004002"
            },
            {
              "ru": 10,
              "gr": 10
            }
          ]
        },
        {
          "n": 5,
          "text": "Господь же да управит сердца ваши в любовь Божию и в терпение Христово.",
          "alignment": [
            {
              "ru": 0,
              "gr": 2,
              "srcId": "n53003005003",
              "tgtId": "53003005001"
            },
            {
              "ru": 3,
              "gr": 3,
              "srcId": "n53003005004",
              "tgtId": "53003005004"
            },
            {
              "ru": 4,
              "gr": 6,
              "srcId": "n53003005007",
              "tgtId": "53003005005"
            },
            {
              "ru": 7,
              "gr": 9,
              "srcId": "n53003005010",
              "tgtId": "53003005008"
            },
            {
              "ru": 8,
              "gr": 11,
              "srcId": "n53003005012",
              "tgtId": "53003005009"
            },
            {
              "ru": 11,
              "gr": 15,
              "srcId": "n53003005016",
              "tgtId": "53003005012"
            },
            {
              "ru": 12,
              "gr": 17,
              "srcId": "n53003005018",
              "tgtId": "53003005013"
            }
          ]
        },
        {
          "n": 6,
          "text": "Завещеваем же вам, братия, именем Господа нашего Иисуса Христа, удаляться от всякого брата, поступающего бесчинно, а не по преданию, которое приняли от нас,",
          "alignment": [
            {
              "ru": 0,
              "gr": 0,
              "srcId": "n53003006001",
              "tgtId": "53003006001"
            },
            {
              "ru": 7,
              "gr": 3,
              "srcId": "n53003006004",
              "tgtId": "53003006010"
            },
            {
              "ru": 8,
              "gr": 5,
              "srcId": "n53003006006",
              "tgtId": "53003006011"
            },
            {
              "ru": 13,
              "gr": 10,
              "srcId": "n53003006011",
              "tgtId": "53003006018"
            },
            {
              "ru": 14,
              "gr": 11,
              "srcId": "n53003006012",
              "tgtId": "53003006019"
            },
            {
              "ru": 15,
              "gr": 14,
              "srcId": "n53003006015",
              "tgtId": "53003006021"
            },
            {
              "ru": 19,
              "gr": 17,
              "srcId": "n53003006018",
              "tgtId": "53003006026"
            }
          ]
        },
        {
          "n": 7,
          "text": "ибо вы сами знаете, как должны вы подражать нам; ибо мы не бесчинствовали у вас,",
          "alignment": [
            {
              "ru": 5,
              "gr": 2,
              "srcId": "n53003007003",
              "tgtId": "53003007007"
            },
            {
              "ru": 6,
              "gr": 3,
              "srcId": "n53003007004",
              "tgtId": "53003007008"
            },
            {
              "ru": 14,
              "gr": 9,
              "srcId": "n53003007010",
              "tgtId": "53003007017"
            }
          ]
        },
        {
          "n": 8,
          "text": "ни у кого не ели хлеба даром, но занимались трудом и работою ночь и день, чтобы не обременить кого из вас, -",
          "alignment": [
            {
              "ru": 0,
              "gr": 0,
              "srcId": "n53003008001",
              "tgtId": "53003008001"
            },
            {
              "ru": 2,
              "gr": 5,
              "srcId": "n53003008006",
              "tgtId": "53003008003"
            },
            {
              "ru": 4,
              "gr": 3,
              "srcId": "n53003008004",
              "tgtId": "53003008005"
            },
            {
              "ru": 5,
              "gr": 2,
              "srcId": "n53003008003",
              "tgtId": "53003008006"
            },
            {
              "ru": 8,
              "gr": 1,
              "srcId": "n53003008002",
              "tgtId": "53003008010"
            },
            {
              "ru": 10,
              "gr": 14,
              "srcId": "n53003008015",
              "tgtId": "53003008012"
            },
            {
              "ru": 11,
              "gr": 8,
              "srcId": "n53003008009",
              "tgtId": "53003008013"
            },
            {
              "ru": 13,
              "gr": 10,
              "srcId": "n53003008011",
              "tgtId": "53003008015"
            },
            {
              "ru": 14,
              "gr": 11,
              "srcId": "n53003008012",
              "tgtId": "53003008016"
            },
            {
              "ru": 18,
              "gr": 13,
              "srcId": "n53003008014",
              "tgtId": "53003008021"
            }
          ]
        },
        {
          "n": 9,
          "text": "не потому, чтобы мы не имели власти, но чтобы себя самих дать вам в образец для подражания нам.",
          "alignment": [
            {
              "ru": 13,
              "gr": 7,
              "srcId": "n53003009008",
              "tgtId": "53003009016"
            },
            {
              "ru": 14,
              "gr": 9,
              "srcId": "n53003009010",
              "tgtId": "53003009017"
            },
            {
              "ru": 17,
              "gr": 8,
              "srcId": "n53003009009",
              "tgtId": "53003009020"
            }
          ]
        },
        {
          "n": 10,
          "text": "Ибо когда мы были у вас, то завещевали вам сие: если кто не хочет трудиться, тот и не ешь.",
          "alignment": [
            {
              "ru": 9,
              "gr": 7,
              "srcId": "n53003010008",
              "tgtId": "53003010011"
            },
            {
              "ru": 13,
              "gr": 11,
              "srcId": "n53003010012",
              "tgtId": "53003010016"
            },
            {
              "ru": 18,
              "gr": 14,
              "srcId": "n53003010015",
              "tgtId": "53003010022"
            }
          ]
        },
        {
          "n": 11,
          "text": "Но слышим, что некоторые у вас поступают бесчинно, ничего не делают, а суетятся.",
          "alignment": [
            {
              "ru": 3,
              "gr": 0,
              "srcId": "n53003011001",
              "tgtId": "53003011005"
            },
            {
              "ru": 5,
              "gr": 2,
              "srcId": "n53003011003",
              "tgtId": "53003011007"
            }
          ]
        },
        {
          "n": 12,
          "text": "Таковых увещеваем и убеждаем Господом нашим Иисусом Христом, чтобы они, работая в безмолвии, ели свой хлеб.",
          "alignment": [
            {
              "ru": 2,
              "gr": 3,
              "srcId": "n53003012004",
              "tgtId": "53003012003"
            },
            {
              "ru": 4,
              "gr": 5,
              "srcId": "n53003012006",
              "tgtId": "53003012005"
            },
            {
              "ru": 5,
              "gr": 7,
              "srcId": "n53003012008",
              "tgtId": "53003012006"
            },
            {
              "ru": 7,
              "gr": 8,
              "srcId": "n53003012009",
              "tgtId": "53003012008"
            },
            {
              "ru": 13,
              "gr": 13,
              "srcId": "n53003012014",
              "tgtId": "53003012017"
            }
          ]
        },
        {
          "n": 13,
          "text": "Вы же, братия, не унывайте, делая добро.",
          "alignment": [
            {
              "ru": 5,
              "gr": 2,
              "srcId": "n53003013003",
              "tgtId": "53003013009"
            }
          ]
        },
        {
          "n": 14,
          "text": "Если же кто не послушает слова нашего в сем послании, того имейте на замечании и не сообщайтесь с ним, чтобы устыдить его.",
          "alignment": [
            {
              "ru": 2,
              "gr": 2,
              "srcId": "n53003014003",
              "tgtId": "53003014003"
            },
            {
              "ru": 4,
              "gr": 4,
              "srcId": "n53003014005",
              "tgtId": "53003014005"
            },
            {
              "ru": 5,
              "gr": 6,
              "srcId": "n53003014007",
              "tgtId": "53003014006"
            },
            {
              "ru": 11,
              "gr": 10,
              "srcId": "n53003014011",
              "tgtId": "53003014013"
            },
            {
              "ru": 15,
              "gr": 12,
              "srcId": "n53003014013",
              "tgtId": "53003014017"
            },
            {
              "ru": 18,
              "gr": 14,
              "srcId": "n53003014015",
              "tgtId": "53003014020"
            }
          ]
        },
