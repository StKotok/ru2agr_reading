          "text": "Да не обольстит вас никто никак: ибо день тот не придет, доколе не придет прежде отступление и не откроется человек греха, сын погибели,",
          "alignment": [
            {
              "ru": 2,
              "gr": 3,
              "srcId": "n53002003004",
              "tgtId": "53002003003"
            },
            {
              "ru": 4,
              "gr": 1,
              "srcId": "n53002003002",
              "tgtId": "53002003005"
            },
            {
              "ru": 5,
              "gr": 6,
              "srcId": "n53002003007",
              "tgtId": "53002003006"
            },
            {
              "ru": 15,
              "gr": 10,
              "srcId": "n53002003011",
              "tgtId": "53002003018"
            },
