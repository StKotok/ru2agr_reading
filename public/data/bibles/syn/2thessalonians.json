              "tgtId": "53002015011"
            },
            {
              "ru": 13,
              "gr": 9,
              "srcId": "n53002015010",
              "tgtId": "53002015018"
            }
          ]
        },
        {
          "n": 16,
          "text": "Сам же Господь наш Иисус Христос и Бог и Отец наш, возлюбивший нас и давший утешение вечное и надежду благую во благодати,",
          "alignment": [
            {
              "ru": 2,
              "gr": 3,
              "srcId": "n53002016004",
              "tgtId": "53002016003"
            },
            {
              "ru": 4,
              "gr": 5,
              "srcId": "n53002016006",
              "tgtId": "53002016005"
            },
            {
              "ru": 5,
              "gr": 6,
              "srcId": "n53002016007",
              "tgtId": "53002016006"
            },
            {
              "ru": 7,
