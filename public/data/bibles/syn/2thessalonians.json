              "ru": 0,
              "gr": 0,
              "srcId": "n53002001001",
              "tgtId": "53002001001"
            },
            {
              "ru": 6,
              "gr": 3,
              "srcId": "n53002001004",
              "tgtId": "53002001009"
            },
            {
              "ru": 8,
              "gr": 6,
              "srcId": "n53002001007",
              "tgtId": "53002001011"
            },
            {
              "ru": 11,
              "gr": 10,
              "srcId": "n53002001011",
              "tgtId": "53002001014"
            }
          ]
        },
        {
