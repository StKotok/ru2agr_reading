{
  "id": "philemon",
  "title": "Послание к Филимону",
  "short": "Флм",
  "chapters": [
    {
      "n": 1,
      "verses": [
        {
          "n": 1,
          "text": "Павел, узник Иисуса Христа, и Тимофей брат, Филимону возлюбленному и сотруднику нашему,",
          "alignment": [
            {
              "ru": 2,
              "gr": 0,
              "srcId": "n57001001001",
              "tgtId": "57001001004"
            },
            {
              "ru": 3,
              "gr": 1,
              "srcId": "n57001001002",
              "tgtId": "57001001005"
            },
            {
              "ru": 8,
              "gr": 5,
              "srcId": "n57001001006",
              "tgtId": "57001001012"
            }
          ]
        },
        {
          "n": 2,
          "text": "и Апфии, (сестре) возлюбленной, и Архиппу, сподвижнику нашему, и домашней твоей церкви:",
          "alignment": [
            {
              "ru": 9,
              "gr": 5,
              "srcId": "n57001002006",
              "tgtId": "57001002017"
            },
            {
              "ru": 10,
              "gr": 7,
              "srcId": "n57001002008",
              "tgtId": "57001002018"
            }
          ]
        },
        {
          "n": 3,
          "text": "благодать вам и мир от Бога Отца нашего и Господа Иисуса Христа.",
          "alignment": [
            {
              "ru": 0,
              "gr": 0,
              "srcId": "n57001003001",
              "tgtId": "57001003001"
            },
            {
              "ru": 3,
              "gr": 3,
              "srcId": "n57001003004",
              "tgtId": "57001003004"
            },
            {
              "ru": 5,
              "gr": 5,
              "srcId": "n57001003006",
              "tgtId": "57001003006"
            },
            {
              "ru": 6,
              "gr": 6,
              "srcId": "n57001003007",
              "tgtId": "57001003007"
            },
            {
              "ru": 9,
              "gr": 9,
              "srcId": "n57001003010",
              "tgtId": "57001003010"
            },
            {
              "ru": 10,
              "gr": 10,
              "srcId": "n57001003011",
              "tgtId": "57001003011"
            },
            {
              "ru": 11,
              "gr": 11,
              "srcId": "n57001003012",
              "tgtId": "57001003012"
            }
          ]
        },
        {
          "n": 4,
          "text": "Благодарю Бога моего, всегда вспоминая о тебе в молитвах моих,",
          "alignment": [
            {
              "ru": 0,
              "gr": 0,
              "srcId": "n57001004001",
              "tgtId": "57001004001"
            },
            {
              "ru": 1,
              "gr": 2,
              "srcId": "n57001004003",
              "tgtId": "57001004002"
            },
            {
              "ru": 5,
              "gr": 4,
              "srcId": "n57001004005",
              "tgtId": "57001004007"
            },
            {
              "ru": 6,
              "gr": 5,
              "srcId": "n57001004006",
              "tgtId": "57001004008"
            },
            {
              "ru": 8,
              "gr": 7,
              "srcId": "n57001004008",
              "tgtId": "57001004010"
            }
          ]
        },
        {
          "n": 5,
          "text": "слыша о твоей любви и вере, которую имеешь к Господу Иисусу и ко всем святым,",
          "alignment": [
            {
              "ru": 0,
              "gr": 0,
              "srcId": "n57001005001",
              "tgtId": "57001005001"
            },
            {
              "ru": 3,
              "gr": 3,
              "srcId": "n57001005004",
              "tgtId": "57001005004"
            },
            {
              "ru": 7,
              "gr": 6,
              "srcId": "n57001005007",
              "tgtId": "57001005009"
            }
          ]
        },
        {
          "n": 6,
          "text": "дабы общение веры твоей оказалось деятельным в познании всякого у вас добра во Христе Иисусе.",
          "alignment": [
            {
              "ru": 0,
              "gr": 0,
              "srcId": "n57001006001",
              "tgtId": "57001006001"
            },
            {
              "ru": 1,
              "gr": 2,
              "srcId": "n57001006003",
              "tgtId": "57001006002"
            },
            {
              "ru": 2,
              "gr": 4,
              "srcId": "n57001006005",
              "tgtId": "57001006003"
            },
            {
              "ru": 5,
              "gr": 6,
              "srcId": "n57001006007",
              "tgtId": "57001006006"
            },
            {
              "ru": 7,
              "gr": 9,
              "srcId": "n57001006010",
              "tgtId": "57001006008"
            },
            {
              "ru": 8,
              "gr": 10,
              "srcId": "n57001006011",
              "tgtId": "57001006009"
            },
            {
              "ru": 11,
              "gr": 11,
              "srcId": "n57001006012",
              "tgtId": "57001006012"
            },
            {
              "ru": 13,
              "gr": 16,
              "srcId": "n57001006017",
              "tgtId": "57001006014"
            }
          ]
        },
        {
          "n": 7,
          "text": "Ибо мы имеем великую радость и утешение в любви твоей, потому что тобою, брат, успокоены сердца святых.",
          "alignment": [
            {
              "ru": 3,
              "gr": 2,
              "srcId": "n57001007003",
              "tgtId": "57001007004"
            },
            {
              "ru": 6,
              "gr": 5,
              "srcId": "n57001007006",
              "tgtId": "57001007007"
            },
            {
              "ru": 8,
              "gr": 8,
              "srcId": "n57001007009",
              "tgtId": "57001007009"
            }
          ]
        },
        {
          "n": 8,
          "text": "Посему, имея великое во Христе дерзновение приказывать тебе, что должно,",
          "alignment": [
            {
              "ru": 2,
              "gr": 0,
              "srcId": "n57001008001",
              "tgtId": "57001008004"
            },
            {
              "ru": 4,
              "gr": 1,
              "srcId": "n57001008002",
              "tgtId": "57001008006"
            },
            {
              "ru": 6,
              "gr": 3,
              "srcId": "n57001008004",
              "tgtId": "57001008008"
            },
            {
              "ru": 7,
              "gr": 4,
              "srcId": "n57001008005",
              "tgtId": "57001008009"
            }
          ]
        },
        {
          "n": 9,
          "text": "по любви лучше прошу, не иной кто, как я, Павел старец, а теперь и узник Иисуса Христа;",
          "alignment": [
            {
              "ru": 1,
              "gr": 2,
              "srcId": "n57001009003",
              "tgtId": "57001009002"
            },
            {
              "ru": 2,
              "gr": 3,
              "srcId": "n57001009004",
              "tgtId": "57001009003"
            },
            {
              "ru": 5,
              "gr": 4,
              "srcId": "n57001009005",
              "tgtId": "57001009007"
            },
            {
              "ru": 9,
              "gr": 5,
              "srcId": "n57001009006",
              "tgtId": "57001009013"
            },
            {
              "ru": 13,
              "gr": 8,
              "srcId": "n57001009009",
              "tgtId": "57001009018"
            }
          ]
        },
        {
          "n": 10,
          "text": "прошу тебя о сыне моем Онисиме, которого родил я в узах моих:",
          "alignment": [
            {
              "ru": 0,
              "gr": 0,
              "srcId": "n57001010001",
              "tgtId": "57001010001"
            },
            {
              "ru": 3,
              "gr": 5,
              "srcId": "n57001010006",
              "tgtId": "57001010004"
            },
            {
              "ru": 4,
              "gr": 4,
              "srcId": "n57001010005",
              "tgtId": "57001010005"
            },
            {
              "ru": 7,
              "gr": 11,
              "srcId": "n57001010012",
              "tgtId": "57001010009"
            },
            {
              "ru": 9,
              "gr": 7,
              "srcId": "n57001010008",
              "tgtId": "57001010011"
            }
          ]
        },
        {
          "n": 11,
          "text": "он был некогда негоден для тебя, а теперь годен тебе и мне; я возвращаю его;",
          "alignment": [
            {
              "ru": 2,
              "gr": 1,
              "srcId": "n57001011002",
              "tgtId": "57001011003"
            },
            {
              "ru": 3,
              "gr": 3,
              "srcId": "n57001011004",
              "tgtId": "57001011004"
            },
            {
              "ru": 9,
              "gr": 4,
              "srcId": "n57001011005",
              "tgtId": "57001011011"
            },
            {
              "ru": 10,
              "gr": 9,
              "srcId": "n57001011010",
              "tgtId": "57001011012"
            }
          ]
        },
        {
          "n": 12,
          "text": "ты же прими его, как мое сердце."
        },
        {
          "n": 13,
          "text": "Я хотел при себе удержать его, дабы он вместо тебя послужил мне в узах за благовествование;",
          "alignment": [
            {
              "ru": 1,
              "gr": 2,
              "srcId": "n57001013003",
              "tgtId": "57001013002"
            },
            {
              "ru": 3,
              "gr": 4,
              "srcId": "n57001013005",
              "tgtId": "57001013004"
            },
            {
              "ru": 4,
              "gr": 5,
              "srcId": "n57001013006",
              "tgtId": "57001013005"
            },
            {
              "ru": 12,
              "gr": 10,
              "srcId": "n57001013011",
              "tgtId": "57001013014"
            },
            {
              "ru": 15,
              "gr": 13,
              "srcId": "n57001013014",
              "tgtId": "57001013017"
            }
          ]
        },
        {
          "n": 14,
          "text": "но без твоего согласия ничего не хотел сделать, чтобы доброе дело твое было не вынужденно, а добровольно.",
          "alignment": [
            {
              "ru": 2,
              "gr": 3,
              "srcId": "n57001014004",
              "tgtId": "57001014003"
            },
            {
              "ru": 3,
              "gr": 4,
              "srcId": "n57001014005",
              "tgtId": "57001014004"
            },
            {
              "ru": 6,
              "gr": 6,
              "srcId": "n57001014007",
              "tgtId": "57001014007"
            },
            {
              "ru": 9,
              "gr": 7,
              "srcId": "n57001014008",
              "tgtId": "57001014011"
            },
            {
              "ru": 11,
              "gr": 14,
              "srcId": "n57001014015",
              "tgtId": "57001014013"
            }
          ]
        },
        {
          "n": 15,
          "text": "Ибо, может быть, он для того на время отлучился, чтобы тебе принять его навсегда,",
          "alignment": [
            {
              "ru": 9,
              "gr": 6,
              "srcId": "n57001015007",
              "tgtId": "57001015013"
            },
            {
              "ru": 13,
              "gr": 4,
              "srcId": "n57001015005",
              "tgtId": "57001015017"
            }
          ]
        },
        {
          "n": 16,
          "text": "не как уже раба, но выше раба, брата возлюбленного, особенно мне, а тем больше тебе, и по плоти и в Господе.",
          "alignment": [
            {
              "ru": 0,
              "gr": 0,
              "srcId": "n57001016001",
              "tgtId": "57001016001"
            },
            {
              "ru": 3,
              "gr": 2
            },
            {
              "ru": 5,
              "gr": 5
            },
            {
              "ru": 10,
              "gr": 6,
              "srcId": "n57001016007",
              "tgtId": "57001016014"
            },
            {
              "ru": 13,
              "gr": 7,
              "srcId": "n57001016008",
              "tgtId": "57001016018"
            },
            {
              "ru": 14,
              "gr": 8,
              "srcId": "n57001016009",
              "tgtId": "57001016019"
            },
            {
              "ru": 19,
              "gr": 10,
              "srcId": "n57001016011",
              "tgtId": "57001016025"
            },
            {
              "ru": 20,
              "gr": 12,
              "srcId": "n57001016013",
              "tgtId": "57001016026"
            }
          ]
        },
        {
          "n": 17,
          "text": "Итак, если ты имеешь общение со мною, то прими его, как меня.",
          "alignment": [
            {
              "ru": 6,
              "gr": 4,
              "srcId": "n57001017005",
              "tgtId": "57001017008"
            },
            {
              "ru": 11,
              "gr": 5,
              "srcId": "n57001017006",
              "tgtId": "57001017015"
            }
          ]
        },
        {
          "n": 18,
          "text": "Если же он чем обидел тебя, или должен, считай это на мне.",
          "alignment": [
            {
              "ru": 3,
              "gr": 2,
              "srcId": "n57001018003",
              "tgtId": "57001018004"
            },
            {
              "ru": 4,
              "gr": 3,
              "srcId": "n57001018004",
              "tgtId": "57001018005"
            },
            {
              "ru": 11,
              "gr": 6,
              "srcId": "n57001018007",
              "tgtId": "57001018013"
            }
          ]
        },
        {
          "n": 19,
          "text": "Я, Павел, написал моею рукою: я заплачу; не говорю тебе о том, что ты и самим собою мне должен.",
          "alignment": [
            {
              "ru": 1,
              "gr": 1,
              "srcId": "n57001019002",
              "tgtId": "57001019003"
            },
            {
              "ru": 2,
              "gr": 2,
              "srcId": "n57001019003",
              "tgtId": "57001019005"
            },
            {
              "ru": 3,
              "gr": 4,
              "srcId": "n57001019005",
              "tgtId": "57001019006"
            },
            {
              "ru": 4,
              "gr": 5,
              "srcId": "n57001019006",
              "tgtId": "57001019007"
            },
            {
              "ru": 6,
              "gr": 7,
              "srcId": "n57001019008",
              "tgtId": "57001019010"
            },
            {
              "ru": 17,
              "gr": 14,
              "srcId": "n57001019015",
              "tgtId": "57001019023"
            }
          ]
        },
        {
          "n": 20,
          "text": "Так, брат, дай мне воспользоваться от тебя в Господе; успокой мое сердце в Господе.",
          "alignment": [
            {
              "ru": 5,
              "gr": 1,
              "srcId": "n57001020002",
              "tgtId": "57001020008"
            },
            {
              "ru": 8,
              "gr": 4,
              "srcId": "n57001020005",
              "tgtId": "57001020011"
            },
            {
              "ru": 11,
              "gr": 6,
              "srcId": "n57001020007",
              "tgtId": "57001020015"
            },
            {
              "ru": 13,
              "gr": 7,
              "srcId": "n57001020008",
              "tgtId": "57001020017"
            }
          ]
        },
        {
          "n": 21,
          "text": "Надеясь на послушание твое, я написал к тебе, зная, что ты сделаешь и более, нежели говорю.",
          "alignment": [
            {
              "ru": 0,
              "gr": 0,
              "srcId": "n57001021001",
              "tgtId": "57001021001"
            },
            {
              "ru": 2,
              "gr": 2,
              "srcId": "n57001021003",
              "tgtId": "57001021003"
            }
          ]
        },
        {
          "n": 22,
          "text": "А вместе приготовь для меня и помещение; ибо надеюсь, что по молитвам вашим я буду дарован вам.",
          "alignment": [
            {
              "ru": 1,
              "gr": 0,
              "srcId": "n57001022001",
              "tgtId": "57001022002"
            },
            {
              "ru": 2,
              "gr": 3,
              "srcId": "n57001022004",
              "tgtId": "57001022003"
            },
            {
              "ru": 6,
              "gr": 5,
              "srcId": "n57001022006",
              "tgtId": "57001022007"
            },
            {
              "ru": 10,
              "gr": 6,
              "srcId": "n57001022007",
              "tgtId": "57001022013"
            },
            {
              "ru": 13,
              "gr": 11,
              "srcId": "n57001022012",
              "tgtId": "57001022016"
            }
          ]
        },
        {
          "n": 23,
          "text": "Приветствует тебя Епафрас, узник вместе со мною ради Христа Иисуса,",
          "alignment": [
            {
              "ru": 0,
              "gr": 0,
              "srcId": "n57001023001",
              "tgtId": "57001023001"
            },
            {
              "ru": 4,
              "gr": 2,
              "srcId": "n57001023003",
              "tgtId": "57001023006"
            },
            {
              "ru": 5,
              "gr": 4,
              "srcId": "n57001023005",
              "tgtId": "57001023007"
            }
          ]
        },
        {
          "n": 24,
          "text": "Марк, Аристарх, Димас, Лука, сотрудники мои.",
          "alignment": [
            {
              "ru": 0,
              "gr": 0
            },
            {
              "ru": 1,
              "gr": 1
            },
            {
              "ru": 2,
              "gr": 2
            },
            {
              "ru": 3,
              "gr": 3
            },
            {
              "ru": 4,
              "gr": 5
            },
            {
              "ru": 5,
              "gr": 6
            }
          ]
        },
        {
          "n": 25,
          "text": "Благодать Господа нашего Иисуса Христа со духом вашим. Аминь.",
          "alignment": [
            {
              "ru": 0,
              "gr": 1,
              "srcId": "n57001025002",
              "tgtId": "57001025001"
            },
            {
              "ru": 1,
              "gr": 3,
              "srcId": "n57001025004",
              "tgtId": "57001025002"
            },
            {
              "ru": 3,
              "gr": 4,
              "srcId": "n57001025005",
              "tgtId": "57001025004"
            },
            {
              "ru": 4,
              "gr": 5,
              "srcId": "n57001025006",
              "tgtId": "57001025005"
            },
            {
              "ru": 6,
              "gr": 8,
              "srcId": "n57001025009",
              "tgtId": "57001025007"
            }
          ]
        }
      ]
    }
  ]
}