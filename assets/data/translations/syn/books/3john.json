{"schema":"translation-book-v1","translationId":"syn","bookId":"3john","title":"Третье послание Иоанна","short":"3 Ин","chapters":[{"n":1,"verses":[{"ref":"3john 1:1","n":1,"text":"Старец - возлюбленному Гаию, которого я люблю по истине.","words":[{"i":0,"text":"Старец","start":0,"end":6},{"i":1,"text":"возлюбленному","start":9,"end":22},{"i":2,"text":"Гаию","start":23,"end":27},{"i":3,"text":"которого","start":29,"end":37},{"i":4,"text":"я","start":38,"end":39},{"i":5,"text":"люблю","start":40,"end":45},{"i":6,"text":"по","start":46,"end":48},{"i":7,"text":"истине","start":49,"end":55}]},{"ref":"3john 1:2","n":2,"text":"Возлюбленный! молюсь, чтобы ты здравствовал и преуспевал во всем, как преуспевает душа твоя.","words":[{"i":0,"text":"Возлюбленный","start":0,"end":12},{"i":1,"text":"молюсь","start":14,"end":20},{"i":2,"text":"чтобы","start":22,"end":27},{"i":3,"text":"ты","start":28,"end":30},{"i":4,"text":"здравствовал","start":31,"end":43},{"i":5,"text":"и","start":44,"end":45},{"i":6,"text":"преуспевал","start":46,"end":56},{"i":7,"text":"во","start":57,"end":59},{"i":8,"text":"всем","start":60,"end":64},{"i":9,"text":"как","start":66,"end":69},{"i":10,"text":"преуспевает","start":70,"end":81},{"i":11,"text":"душа","start":82,"end":86},{"i":12,"text":"твоя","start":87,"end":91}]},{"ref":"3john 1:3","n":3,"text":"Ибо я весьма обрадовался, когда пришли братия и засвидетельствовали о твоей верности, как ты ходишь в истине.","words":[{"i":0,"text":"Ибо","start":0,"end":3},{"i":1,"text":"я","start":4,"end":5},{"i":2,"text":"весьма","start":6,"end":12},{"i":3,"text":"обрадовался","start":13,"end":24},{"i":4,"text":"когда","start":26,"end":31},{"i":5,"text":"пришли","start":32,"end":38},{"i":6,"text":"братия","start":39,"end":45},{"i":7,"text":"и","start":46,"end":47},{"i":8,"text":"засвидетельствовали","start":48,"end":67},{"i":9,"text":"о","start":68,"end":69},{"i":10,"text":"твоей","start":70,"end":75},{"i":11,"text":"верности","start":76,"end":84},{"i":12,"text":"как","start":86,"end":89},{"i":13,"text":"ты","start":90,"end":92},{"i":14,"text":"ходишь","start":93,"end":99},{"i":15,"text":"в","start":100,"end":101},{"i":16,"text":"истине","start":102,"end":108}]},{"ref":"3john 1:4","n":4,"text":"Для меня нет большей радости, как слышать, что дети мои ходят в истине.","words":[{"i":0,"text":"Для","start":0,"end":3},{"i":1,"text":"меня","start":4,"end":8},{"i":2,"text":"нет","start":9,"end":12},{"i":3,"text":"большей","start":13,"end":20},{"i":4,"text":"радости","start":21,"end":28},{"i":5,"text":"как","start":30,"end":33},{"i":6,"text":"слышать","start":34,"end":41},{"i":7,"text":"что","start":43,"end":46},{"i":8,"text":"дети","start":47,"end":51},{"i":9,"text":"мои","start":52,"end":55},{"i":10,"text":"ходят","start":56,"end":61},{"i":11,"text":"в","start":62,"end":63},{"i":12,"text":"истине","start":64,"end":70}]},{"ref":"3john 1:5","n":5,"text":"Возлюбленный! ты как верный поступаешь в том, что делаешь для братьев и для странников.","words":[{"i":0,"text":"Возлюбленный","start":0,"end":12},{"i":1,"text":"ты","start":14,"end":16},{"i":2,"text":"как","start":17,"end":20},{"i":3,"text":"верный","start":21,"end":27},{"i":4,"text":"поступаешь","start":28,"end":38},{"i":5,"text":"в","start":39,"end":40},{"i":6,"text":"том","start":41,"end":44},{"i":7,"text":"что","start":46,"end":49},{"i":8,"text":"делаешь","start":50,"end":57},{"i":9,"text":"для","start":58,"end":61},{"i":10,"text":"братьев","start":62,"end":69},{"i":11,"text":"и","start":70,"end":71},{"i":12,"text":"для","start":72,"end":75},{"i":13,"text":"странников","start":76,"end":86}]},{"ref":"3john 1:6","n":6,"text":"Они засвидетельствовали перед церковью о твоей любви. Ты хорошо поступишь, если отпустишь их, как должно ради Бога,","words":[{"i":0,"text":"Они","start":0,"end":3},{"i":1,"text":"засвидетельствовали","start":4,"end":23},{"i":2,"text":"перед","start":24,"end":29},{"i":3,"text":"церковью","start":30,"end":38},{"i":4,"text":"о","start":39,"end":40},{"i":5,"text":"твоей","start":41,"end":46},{"i":6,"text":"любви","start":47,"end":52},{"i":7,"text":"Ты","start":54,"end":56},{"i":8,"text":"хорошо","start":57,"end":63},{"i":9,"text":"поступишь","start":64,"end":73},{"i":10,"text":"если","start":75,"end":79},{"i":11,"text":"отпустишь","start":80,"end":89},{"i":12,"text":"их","start":90,"end":92},{"i":13,"text":"как","start":94,"end":97},{"i":14,"text":"должно","start":98,"end":104},{"i":15,"text":"ради","start":105,"end":109},{"i":16,"text":"Бога","start":110,"end":114}]},{"ref":"3john 1:7","n":7,"text":"ибо они ради имени Его пошли, не взяв ничего от язычников.","words":[{"i":0,"text":"ибо","start":0,"end":3},{"i":1,"text":"они","start":4,"end":7},{"i":2,"text":"ради","start":8,"end":12},{"i":3,"text":"имени","start":13,"end":18},{"i":4,"text":"Его","start":19,"end":22},{"i":5,"text":"пошли","start":23,"end":28},{"i":6,"text":"не","start":30,"end":32},{"i":7,"text":"взяв","start":33,"end":37},{"i":8,"text":"ничего","start":38,"end":44},{"i":9,"text":"от","start":45,"end":47},{"i":10,"text":"язычников","start":48,"end":57}]},{"ref":"3john 1:8","n":8,"text":"Итак мы должны принимать таковых, чтобы сделаться споспешниками истине.","words":[{"i":0,"text":"Итак","start":0,"end":4},{"i":1,"text":"мы","start":5,"end":7},{"i":2,"text":"должны","start":8,"end":14},{"i":3,"text":"принимать","start":15,"end":24},{"i":4,"text":"таковых","start":25,"end":32},{"i":5,"text":"чтобы","start":34,"end":39},{"i":6,"text":"сделаться","start":40,"end":49},{"i":7,"text":"споспешниками","start":50,"end":63},{"i":8,"text":"истине","start":64,"end":70}]},{"ref":"3john 1:9","n":9,"text":"Я писал церкви; но любящий первенствовать у них Диотреф не принимает нас.","words":[{"i":0,"text":"Я","start":0,"end":1},{"i":1,"text":"писал","start":2,"end":7},{"i":2,"text":"церкви","start":8,"end":14},{"i":3,"text":"но","start":16,"end":18},{"i":4,"text":"любящий","start":19,"end":26},{"i":5,"text":"первенствовать","start":27,"end":41},{"i":6,"text":"у","start":42,"end":43},{"i":7,"text":"них","start":44,"end":47},{"i":8,"text":"Диотреф","start":48,"end":55},{"i":9,"text":"не","start":56,"end":58},{"i":10,"text":"принимает","start":59,"end":68},{"i":11,"text":"нас","start":69,"end":72}]},{"ref":"3john 1:10","n":10,"text":"Посему, если я приду, то напомню о делах, которые он делает, понося нас злыми словами, и не довольствуясь тем, и сам не принимает братьев, и запрещает желающим, и изгоняет из церкви.","words":[{"i":0,"text":"Посему","start":0,"end":6},{"i":1,"text":"если","start":8,"end":12},{"i":2,"text":"я","start":13,"end":14},{"i":3,"text":"приду","start":15,"end":20},{"i":4,"text":"то","start":22,"end":24},{"i":5,"text":"напомню","start":25,"end":32},{"i":6,"text":"о","start":33,"end":34},{"i":7,"text":"делах","start":35,"end":40},{"i":8,"text":"которые","start":42,"end":49},{"i":9,"text":"он","start":50,"end":52},{"i":10,"text":"делает","start":53,"end":59},{"i":11,"text":"понося","start":61,"end":67},{"i":12,"text":"нас","start":68,"end":71},{"i":13,"text":"злыми","start":72,"end":77},{"i":14,"text":"словами","start":78,"end":85},{"i":15,"text":"и","start":87,"end":88},{"i":16,"text":"не","start":89,"end":91},{"i":17,"text":"довольствуясь","start":92,"end":105},{"i":18,"text":"тем","start":106,"end":109},{"i":19,"text":"и","start":111,"end":112},{"i":20,"text":"сам","start":113,"end":116},{"i":21,"text":"не","start":117,"end":119},{"i":22,"text":"принимает","start":120,"end":129},{"i":23,"text":"братьев","start":130,"end":137},{"i":24,"text":"и","start":139,"end":140},{"i":25,"text":"запрещает","start":141,"end":150},{"i":26,"text":"желающим","start":151,"end":159},{"i":27,"text":"и","start":161,"end":162},{"i":28,"text":"изгоняет","start":163,"end":171},{"i":29,"text":"из","start":172,"end":174},{"i":30,"text":"церкви","start":175,"end":181}]},{"ref":"3john 1:11","n":11,"text":"Возлюбленный! не подражай злу, но добру. Кто делает добро, тот от Бога; а делающий зло не видел Бога.","words":[{"i":0,"text":"Возлюбленный","start":0,"end":12},{"i":1,"text":"не","start":14,"end":16},{"i":2,"text":"подражай","start":17,"end":25},{"i":3,"text":"злу","start":26,"end":29},{"i":4,"text":"но","start":31,"end":33},{"i":5,"text":"добру","start":34,"end":39},{"i":6,"text":"Кто","start":41,"end":44},{"i":7,"text":"делает","start":45,"end":51},{"i":8,"text":"добро","start":52,"end":57},{"i":9,"text":"тот","start":59,"end":62},{"i":10,"text":"от","start":63,"end":65},{"i":11,"text":"Бога","start":66,"end":70},{"i":12,"text":"а","start":72,"end":73},{"i":13,"text":"делающий","start":74,"end":82},{"i":14,"text":"зло","start":83,"end":86},{"i":15,"text":"не","start":87,"end":89},{"i":16,"text":"видел","start":90,"end":95},{"i":17,"text":"Бога","start":96,"end":100}]},{"ref":"3john 1:12","n":12,"text":"О Димитрии засвидетельствовано всеми и самою истиною; свидетельствуем также и мы, и вы знаете, что свидетельство наше истинно.","words":[{"i":0,"text":"О","start":0,"end":1},{"i":1,"text":"Димитрии","start":2,"end":10},{"i":2,"text":"засвидетельствовано","start":11,"end":30},{"i":3,"text":"всеми","start":31,"end":36},{"i":4,"text":"и","start":37,"end":38},{"i":5,"text":"самою","start":39,"end":44},{"i":6,"text":"истиною","start":45,"end":52},{"i":7,"text":"свидетельствуем","start":54,"end":69},{"i":8,"text":"также","start":70,"end":75},{"i":9,"text":"и","start":76,"end":77},{"i":10,"text":"мы","start":78,"end":80},{"i":11,"text":"и","start":82,"end":83},{"i":12,"text":"вы","start":84,"end":86},{"i":13,"text":"знаете","start":87,"end":93},{"i":14,"text":"что","start":95,"end":98},{"i":15,"text":"свидетельство","start":99,"end":112},{"i":16,"text":"наше","start":113,"end":117},{"i":17,"text":"истинно","start":118,"end":125}]},{"ref":"3john 1:13","n":13,"text":"Многое имел я писать; но не хочу писать к тебе чернилами и тростью,","words":[{"i":0,"text":"Многое","start":0,"end":6},{"i":1,"text":"имел","start":7,"end":11},{"i":2,"text":"я","start":12,"end":13},{"i":3,"text":"писать","start":14,"end":20},{"i":4,"text":"но","start":22,"end":24},{"i":5,"text":"не","start":25,"end":27},{"i":6,"text":"хочу","start":28,"end":32},{"i":7,"text":"писать","start":33,"end":39},{"i":8,"text":"к","start":40,"end":41},{"i":9,"text":"тебе","start":42,"end":46},{"i":10,"text":"чернилами","start":47,"end":56},{"i":11,"text":"и","start":57,"end":58},{"i":12,"text":"тростью","start":59,"end":66}]},{"ref":"3john 1:14","n":14,"text":"а надеюсь скоро увидеть тебя и поговорить устами к устам.","words":[{"i":0,"text":"а","start":0,"end":1},{"i":1,"text":"надеюсь","start":2,"end":9},{"i":2,"text":"скоро","start":10,"end":15},{"i":3,"text":"увидеть","start":16,"end":23},{"i":4,"text":"тебя","start":24,"end":28},{"i":5,"text":"и","start":29,"end":30},{"i":6,"text":"поговорить","start":31,"end":41},{"i":7,"text":"устами","start":42,"end":48},{"i":8,"text":"к","start":49,"end":50},{"i":9,"text":"устам","start":51,"end":56}]},{"ref":"3john 1:15","n":15,"text":"Мир тебе. Приветствуют тебя друзья; приветствуй друзей поименно. Аминь.","words":[{"i":0,"text":"Мир","start":0,"end":3},{"i":1,"text":"тебе","start":4,"end":8},{"i":2,"text":"Приветствуют","start":10,"end":22},{"i":3,"text":"тебя","start":23,"end":27},{"i":4,"text":"друзья","start":28,"end":34},{"i":5,"text":"приветствуй","start":36,"end":47},{"i":6,"text":"друзей","start":48,"end":54},{"i":7,"text":"поименно","start":55,"end":63},{"i":8,"text":"Аминь","start":65,"end":70}]}]}]}