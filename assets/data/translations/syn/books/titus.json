{"schema":"translation-book-v1","translationId":"syn","bookId":"titus","title":"Послание к Титу","short":"Тит","chapters":[{"n":1,"verses":[{"ref":"titus 1:1","n":1,"text":"Павел, раб Божий, Апостол же Иисуса Христа, по вере избранных Божиих и познанию истины, относящейся к благочестию,","words":[{"i":0,"text":"Павел","start":0,"end":5},{"i":1,"text":"раб","start":7,"end":10},{"i":2,"text":"Божий","start":11,"end":16},{"i":3,"text":"Апостол","start":18,"end":25},{"i":4,"text":"же","start":26,"end":28},{"i":5,"text":"Иисуса","start":29,"end":35},{"i":6,"text":"Христа","start":36,"end":42},{"i":7,"text":"по","start":44,"end":46},{"i":8,"text":"вере","start":47,"end":51},{"i":9,"text":"избранных","start":52,"end":61},{"i":10,"text":"Божиих","start":62,"end":68},{"i":11,"text":"и","start":69,"end":70},{"i":12,"text":"познанию","start":71,"end":79},{"i":13,"text":"истины","start":80,"end":86},{"i":14,"text":"относящейся","start":88,"end":99},{"i":15,"text":"к","start":100,"end":101},{"i":16,"text":"благочестию","start":102,"end":113}]},{"ref":"titus 1:2","n":2,"text":"в надежде вечной жизни, которую обещал неизменный в слове Бог прежде вековых времен,","words":[{"i":0,"text":"в","start":0,"end":1},{"i":1,"text":"надежде","start":2,"end":9},{"i":2,"text":"вечной","start":10,"end":16},{"i":3,"text":"жизни","start":17,"end":22},{"i":4,"text":"которую","start":24,"end":31},{"i":5,"text":"обещал","start":32,"end":38},{"i":6,"text":"неизменный","start":39,"end":49},{"i":7,"text":"в","start":50,"end":51},{"i":8,"text":"слове","start":52,"end":57},{"i":9,"text":"Бог","start":58,"end":61},{"i":10,"text":"прежде","start":62,"end":68},{"i":11,"text":"вековых","start":69,"end":76},{"i":12,"text":"времен","start":77,"end":83}]},{"ref":"titus 1:3","n":3,"text":"а в свое время явил Свое слово в проповеди, вверенной мне по повелению Спасителя нашего, Бога, -","words":[{"i":0,"text":"а","start":0,"end":1},{"i":1,"text":"в","start":2,"end":3},{"i":2,"text":"свое","start":4,"end":8},{"i":3