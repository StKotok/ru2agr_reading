nd":117},{"i":19,"text":"и","start":118,"end":119},{"i":20,"text":"дело","start":120,"end":124},{"i":21,"text":"веры","start":125,"end":129},{"i":22,"text":"в","start":130,"end":131},{"i":23,"text":"силе","start":132,"end":136}]},{"ref":"2thessalonians 1:12","n":12,"text":"да прославится имя Господа нашего Иисуса Христа в вас, и вы в Нем, по благодати Бога нашего и Господа Иисуса Христа.","words":[{"i":0,"text":"да","start":0,"end":2},{"i":1,"text":"прославится","start":3,"end":14},{"i":2,"text":"имя","start":15,"end":18},{"i":3,"text":"Господа","start":19,"end":26},{"i":4,"text":"нашего","start":27,"end":33},{"i":5,"text":"Иисуса","start":34,"end":40},{"i":6,"text":"Христа","start":41,"end":47},{"i":7,"text":"в","start":48,"end":49},{"i":8,"text":"вас","start":50,"end":53},{"i":9,"text":"и","start":55,"end":56},{"i":10,"text":"вы","start":57,"end":59},{"i":11,"text":"в","start":60,"end":61},{"i":12,"text":"Нем","start":62,"end":65},{"i":13,"text":"по","start":67,"end":69},{"i":14,"text":"благодати","start":70,"end":79},{"i":15,"text":"Бога","start":80,"end":84},{"i":16,"text":"нашего","start":85,"end":91},{"i":17,"text":"и","start":92,"end":93},{"i":18,"text":"Господа","start":94,"end":101},{"i":19,"text":"Иисуса","start":102,"end":108},{"i":20,"text":"Христа","start":109,"end":115}]}]},{"n":2,"verses":[{"ref":"2thessalonians 2:1","n":1,"text":"Молим вас, братия, о пришествии Господа нашего Иисуса Христа и нашем собрании к Нему,","words":[{"i":0,"text":"Молим","start":0,"end":5},{"i":1,"text":"вас","start":6,"end":9},{"i":2,"text":"братия","start":11,"end":17},{"i":3,"text":"о","start":19,"end":20},{"i":4,"text":"пришествии","start":21,"end":31},{"i":5,"text":"Господа","start":32,"end":39},{"i":6,"text":"нашего","start":40,"end":46},{"i":7,"text":"Иисуса","start":47,"end":53},{"i":8,"text":"Христа","start":54,"end":60},{"i":9,"text":"и","start":61,"end":62},{"i":10,"text":"нашем","start":63,"end":68},{"i":11,"text":"собрании","start":69,"end":77},{"i":12,"text":"к","start":78,"end":79},{"i":13,"text":"Нему","start":80,"end":84}]},{"ref":"2thessalonians 2:2","n":2,"text":"не спешить колебаться умом и смущаться ни от духа, ни от слова, ни от послания, как бы нами посланного, будто уже наступает день Христов.","words":[{"i":0,"text":"не","start":0,"end":2},{"i":1,"text":"спешить","start":3,"end":10},{"i":2,"text":"колебаться","start":11,"end":21},{"i":3,"text":"умом","start":22,"end":26},{"i":4,"text":"и","start":27,"end":28},{"i":5,"text":"смущаться","start":29,"end":38},{"i":6,"text":"ни","start":39,"end":41},{"i":7,"text":"от","start":42,"end":44},{"i":8,"text":"духа","start":45,"end":49},{"i":9,"text":"ни","start":51,"end":53},{"i":10,"text":"от","start":54,"end":56},{"i":11,"text":"слова","start":57,"end":62},{"i":12,"text":"ни","start":64,"end":66},{"i":13,"text":"от","start":67,"end":69},{"i":14,"text":"послания","start":70,"end":78},{"i":15,"text":"как","start":80,"end":83},{"i":16,"text":"бы","start":84,"end":86},{"i":17,"text":"нами","start":87,"end":91},{"i":18,"text":"посланного","start":92,"end":102},{"i":19,"text":"будто","start":104,"end":109},{"i":20,"text":"уже","start":110,"end":113},{"i":21,"text":"наступает","start":114,"end":123},{"i":22,"text":"день","start":124,"end":128},{"i":23,"text":"Христов","start":129,"end":136}]},{"ref":"2thessalonians 2:3","n":3,"text":"Да не обольстит вас никто никак: ибо день тот не придет, доколе не придет прежде отступление и не откроется человек греха, сын погибели,","words":[{"i":0,"text":"Да","start":0,"end":2},{"i":1,"text":"не","start":3,"end":5},{"i":2,"text":"обольстит","start":6,"end":15},{"i":3,"text":"вас","start":16,"end":19},{"i":4,"text":"никто","start":20,"end":25},{"i":5,"text":"никак","start":26,"end":31},{"i":6,"text":"ибо","start":33,"end":36},{"i":7,"text":"день","start":37,"end":41},{"i":8,"text":"тот","start":42,"end":45},{"i":9,"text":"не","start":46,"end":48},{"i":10,"text":"придет","start":49,"end":55},{"i":11,"text":"доколе","start":57,"end":63},{"i":12,"text":"не","start":64,"end":66},{"i":13,"text":"придет","start":67,"end":73},{"i":14,"text":"прежде","start":74,"end":80},{"i":15,"text":"отступление","start":81,"end":92},{"i":16,"text":"и","start":93,"end":94},{"i":17,"text":"не","start":95,"end":97},{"i":18,"text":"откроется","start":98,"end":107},{"i":19,"text":"человек","start":108,"end":115},{"i":20,"text":"греха","start":116,"end":121},{"i":21,"text":"сын","start":123,"end":126},{"i":22,"text":"погибели","start":127,"end":135}]},{"ref":"2thessalonians 2:4","n":4,"text":"противящийся и превозносящийся выше всего, называемого Богом или святынею, так что в храме Божием сядет он, как Бог, выдавая себя за Бога.","words":[{"i":0,"text":"противящийся","start":0,"end":12},{"i":1,"text":"и","start":13,"end":14},{"i":2,"text":"превозносящийся","start":15,"end":30},{"i":3,"text":"выше","start":31,"end":35},{"i":4,"text":"всего","start":36,"end":41},{"i":5,"text":"называемого","start":43,"end":54},{"i":6,"text":"Богом","start":55,"end":60},{"i":7,"text":"или","start":61,"end":64},{"i":8,"text":"святынею","start":65,"end":73},{"i":9,"text":"так","start":75,"end":78},{"i":10,"text":"что","start":79,"end":82},{"i":11,"text":"в","start":83,"end":84},{"i":12,"text":"храме","start":85,"end":90},{"i":13,"text":"Божием","start":91,"end":97},{"i":14,"text":"сядет","start":98,"end":103},{"i":15,"text":"он","start":104,"end":106},{"i":16,"text":"как","start":108,"end":111},{"i":17,"text":"Бог","start":112,"end":115},{"i":18,"text":"выдавая","start":117,"end":124},{"i":19,"text":"себя","start":125,"end":129},{"i":20,"text":"за","start":130,"end":132},{"i":21,"text":"Бога","start":133,"end":137}]},{"ref":"2thessalonians 2:5","n":5,"text":"Не помните ли, что я, еще находясь у вас, говорил вам это?","words":[{"i":0,"text":"Не","start":0,"end":2},{"i":1,"text":"помните","start":3,"end":10},{"i":2,"text":"ли","start":11,"end":13},{"i":3,"text":"что","start":15,"end":18},{"i":4,"text":"я","start":19,"end":20},{"i":5,"text":"еще","start":22,"end":25},{"i":6,"text":"находясь","start":26,"end":34},{"i":7,"text":"у","start":35,"end":36},{"i":8,"text":"вас","start":37,"end":40},{"i":9,"text":"говорил","start":42,"end":49},{"i":10,"text":"вам","start":50,"end":53},{"i":11,"text":"это","start":54,"end":57}]},{"ref":"2thessalonians 2:6","n":6,"text":"И ныне вы знаете, что не допускает открыться ему в свое время.","words":[{"i":0,"text":"И","start":0,"end":1},{"i":1,"text":"ныне","start":2,"end":6},{"i":2,"text":"вы","start":7,"end":9},{"i":3,"text":"знаете","start":10,"end":16},{"i":4,"text":"что","start":18,"end":21},{"i":5,"text":"не","start":22,"end":24},{"i":6,"text":"допускает","start":25,"end":34},{"i":7,"text":"открыться","start":35,"end":44},{"i":8,"text":"ему","start":45,"end":48},{"i":9,"text":"в","start":49,"end":50},{"i":10,"text":"свое","start":51,"end":55},{"i":11,"text":"время","start":56,"end":61}]},{"ref":"2thessalonians 2:7","n":7,"text":"Ибо тайна беззакония уже в действии, только не совершится до тех пор, пока не будет взят от среды удерживающий теперь.","words":[{"i":0,"text":"Ибо","start":0,"end":3},{"i":1,"text":"тайна","start":4,"end":9},{"i":2,"text":"беззакония","start":10,"end":20},{"i":3,"text":"уже","start":21,"end":24},{"i":4,"text":"в","start":25,"end":26},{"i":5,"text":"действии","start":27,"end":35},{"i":6,"text":"только","start":37,"end":43},{"i":7,"text":"не","start":44,"end":46},{"i":8,"text":"совершится","start":47,"end":57},{"i":9,"text":"до","start":58,"end":60},{"i":10,"text":"тех","start":61,"end":64},{"i":11,"text":"пор","start":65,"end":68},{"i":12,"text":"пока","start":70,"end":74},{"i":13,"text":"не","start":75,"end":77},{"i":14,"text":"будет","start":78,"end":83},{"i":15,"text":"взят","start":84,"end":88},{"i":16,"text":"от","start":89,"end":91},{"i":17,"text":"среды","start":92,"end":97},{"i":18,"text":"удерживающий","start":98,"end":110},{"i":19,"text":"теперь","start":111,"end":117}]},{"ref":"2thessalonians 2:8","n":8,"text":"И тогда откроется беззаконник,