,"end":14},{"i":3,"text":"сердца","start":15,"end":21},{"i":4,"text":"и","start":22,"end":23},{"i":5,"text":"да","start":24,"end":26},{"i":6,"text":"утвердит","start":27,"end":35},{"i":7,"text":"вас","start":36,"end":39},{"i":8,"text":"во","start":40,"end":42},{"i":9,"text":"всяком","start":43,"end":49},{"i":10,"text":"слове","start":50,"end":55},{"i":11,"text":"и","start":56,"end":57},{"i":12,"text":"деле","start":58,"end":62},{"i":13,"text":"благом","start":63,"end":69}]}]},{"n":3,"verses":[{"ref":"2thessalonians 3:1","n":1,"text":"Итак молитесь за нас, братия, чтобы слово Господне распространялось и прославлялось, как и у вас,","words":[{"i":0,"text":"Итак","start":0,"end":4},{"i":1,"text":"молитесь","start":5,"end":13},{"i":2,"text":"за","start":14,"end":16},{"i":3,"text":"нас","start":17,"end":20},{"i":4,"text":"братия","start":22,"end":28},{"i":5,"text":"чтобы","start":30,"end":35},{"i":6,"text":"слово","start":36,"end":41},{"i":7,"text":"Господне","start":42,"end":50},{"i":8,"text":"распространялось","start":51,"end":67},{"i":9,"text":"и","start":68,"end":69},{"i":10,"text":"прославлялось","start":70,"end":83},{"i":11,"text":"как","start":85,"end":88},{"i":12,"text":"и","start":89,"end":90},{"i":13,"text":"у","start":91,"end":92},{"i":14,"text":"вас","start":93,"end":96}]},{"ref":"2thessalonians 3:2","n":2,"text":"и чтобы нам избавиться от беспорядочных и лукавых людей, ибо не во всех вера.","words":[{"i":0,"text":"и","start":0,"end":1},{"i":1,"text":"чтобы","start":2,"end":7},{"i":2,"text":"нам","start":8,"end":11},{"i":3,"text":"избавиться","start":12,"end":22},{"i":4,"text":"от","start":23,"end":25},{"i":5,"text":"беспорядочных","start":26,"end":39},{"i":6,"text":"и","start":40,"end":41},{"i":7,"text":"лукавых","start":42,"end":49},{"i":8,"text":"людей","start":50,"end":55},{"i":9,"text":"ибо","start":57,"end":60},{"i":10,"text":"не","start":61,"end":63},{"i":11,"text":"во","start":64,"end":66},{"i":12,"text":"всех","start":67,"end":71},{"i":13,"text":"вера","start":72,"end":76}]},{"ref":"2thessalonians 3:3","n":3,"text":"Но верен Господь, Который утвердит вас и сохранит от лукавого.","words":[{"i":0,"text":"Но","start":0,"end":2},{"i":1,"text":"верен","start":3,"end":8},{"i":2,"text":"Господь","start":9,"end":16},{"i":3,"text":"Который","start":18,"end":25},{"i":4,"text":"утвердит","start":26,"end":34},{"i":5,"text":"вас","start":35,"end":38},{"i":6,"text":"и","start":39,"end":40},{"i":7,"text":"сохранит","start":41,"end":49},{"i":8,"text":"от","start":50,"end":52},{"i":9,"text":"лукавого","start":53,"end":61}]},{"ref":"2thessalonians 3:4","n":4,"text":"Мы уверены о вас в Господе, что вы исполняете и будете исполнять то, что мы вам повелеваем.","words":[{"i":0,"text":"Мы","start":0,"end":2},{"i":1,"text":"уверены","start":3,"end":10},{"i":2,"text":"о","start":11,"end":12},{"i":3,"text":"вас","start":13,"end":16},{"i":4,"text":"в","start":17,"end":18},{"i":5,"text":"Господе","start":19,"end":26},{"i":6,"text":"что","start":28,"end":31},{"i":7,"text":"вы","start":32,"end":34},{"i":8,"text":"исполняете","start":35,"end":45},{"i":9,"text":"и","start":46,"end":47},{"i":10,"text":"будете","start":48,"end":54},{"i":11,"text":"исполнять","start":55,"end":64},{"i":12,"text":"то","start":65,"end":67},{"i":13,"text":"что","start":69,"end":72},{"i":14,"text":"мы","start":73,"end":75},{"i":15,"text":"вам","start":76,"end":79},{"i":16,"text":"повелеваем","start":80,"end":90}]},{"ref":"2thessalonians 3:5","n":5,"text":"Господь же да управит сердца ваши в любовь Божию и в терпение Христово.","words":[{"i":0,"text":"Господь","start":0,"end":7},{"i":1,"text":"же","start":8,"end":10},{"i":2,"text":"да","start":11,"end":13},{"i":3,"text":"управит","start":14,"end":21},{"i":4,"text":"сердца","start":22,"end":28},{"i":5,"text":"ваши","start":29,"end":33},{"i":6,"text":"в","start":34,"end":35},{"i":7,"text":"любовь","start":36,"end":42},{"i":8,"text":"Божию","start":43,"end":48},{"i":9,"text":"и","start":49,"end":50},{"i":10,"text":"в","s