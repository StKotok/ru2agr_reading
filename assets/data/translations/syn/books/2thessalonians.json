":28,"end":34},{"i":5,"text":"благодарить","start":35,"end":46},{"i":6,"text":"Бога","start":47,"end":51},{"i":7,"text":"за","start":52,"end":54},{"i":8,"text":"вас","start":55,"end":58},{"i":9,"text":"братия","start":60,"end":66},{"i":10,"text":"потому","start":68,"end":74},{"i":11,"text":"что","start":75,"end":78},{"i":12,"text":"возрастает","start":79,"end":89},{"i":13,"text":"вера","start":90,"end":94},{"i":14,"text":"ваша","start":95,"end":99},{"i":15,"text":"и","start":101,"end":102},{"i":16,"text":"умножается","start":103,"end":113},{"i":17,"text":"любовь","start":114,"end":120},{"i":18,"text":"каждого","start":121,"end":128},{"i":19,"text":"друг","start":129,"end":133},{"i":20,"text":"ко","start":134,"end":136},{"i":21,"text":"другу","start":137,"end":142},{"i":22,"text":"между","start":143,"end":148},{"i":23,"text":"всеми","start":149,"end":154},{"i":24,"text":"вами","start":155,"end":159}]},{"ref":"2thessalonians 1:4","n":4,"text":"так что мы сами хвалимся вами в церквах Божиих, терпением вашим и верою во всех гонениях и скорбях, переносимых вами","words":[{"i":0,"text":"так","start":0,"end":3},{"i":1,"text":"что","start":4,"end":7},{"i":2,"text":"мы","start":8,"end":10},{"i":3,"text":"сами","start":11,"end":15},{"i":4,"text":"хвалимся","start":16,"end":24},{"i":5,"text":"вами","start":25,"end":29},{"i":6,"text":"в","start":30,"end":31},{"i":7,"text":"церквах","start":32,"end":39},{"i":8,"text":"Божиих","start":40,"end":46},{"i":9,"text":"терпением","start":48,"end":57},{"i":10,"text":"вашим","start":58,"end":63},{"i":11,"text":"и","start":64,"end":65},{"i":12,"text":"верою","start":66,"end":71},{"i":13,"text":"во","start":72,"end":74},{"i":14,"text":"всех","start":75,"end":79},{"i":15,"text":"гонениях","start":80,"end":88},{"i":16,"text":"и","start":89,"end":90},{"i":17,"text":"скорбях","start":91,"end":98},{"i":18,"text":"переносимых","start":100,"end":111},{"i":19,"text":"вами","start":112,"end":116}]},{"ref":"2thessalonians 1:5","n":5,"text":"в доказательство того, что будет праведный суд Божий, чтобы вам удостоиться Царствия Божия, для которого и страдаете.","words":[{"i":0,"text":"в","start":0,"end":1},{"i":1,"text":"доказательство","start":2,"end":16},{"i":2,"text":"того","start":17,"end":21},{"i":3,"text":"что","start":23,"end":26},{"i":4,"text":"будет","start":27,"end":32},{"i":5,"text":"праведный","start":33,"end":42},{"i":6,"text":"суд","start":43,"end":46},{"i":7,"text":"Божий","start":47,"end":52},{"i":8,"text":"чтобы","start":54,"end":59},{"i":9,"text":"вам","start":60,"end":63},{"i":10,"text":"удостоиться","start":64,"end":75},{"i":11,"text":"Царствия","start":76,"end":84},{"i":12,"text":"Божия","start":85,"end":90},{"i":13,"text":"для","start":92,"end":95},{"i":14,"text":"которого","start":96,"end":104},{"i":15,"text":"и","start":105,"end":106},{"i":16,"text":"страдаете","start":107,"end":116}]},{"ref":"2thessalonians 1:6","n":6,"text":"Ибо праведно пред Богом - оскорбляющим вас воздать скорбью,","words":[{"i":0,"text":"Ибо","start":0,"end":3},{"i":1,"text":"праведно","start":4,"end":12},{"i":2,"text":"пред","start":13,"end":17},{"i":3,"text":"Богом","start":18,"end":23},{"i":4,"text":"оскорбляющим","start":26,"end":38},{"i":5,"text":"вас","start":39,"end":42},{"i":6,"text":"воздать","start":43,"end":50},{"i":7,"text":"скорбью","start":51,"end":58}]},{"ref":"2thessalonians 1:7","n":7,"text":"а вам, оскорбляемым, отрадою вместе с нами, в явление Господа Иисуса с неба, с Ангелами силы Его,","words":[{"i":0,"text":"а","start":0,"end":1},{"i":1,"text":"вам","start":2,"end":5},{"i":2,"text":"оскорбляемым","start":7,"end":19},{"i":3,"text":"отрадою","start":21,"end":28},{"i":4,"text":"вместе","start":29,"end":35},{"i":5,"text":"с","start":36,"end":37},{"i":6,"text":"нами","start":38,"end":42},{"i":7,"text":"в","start":44,"end":45},{"i":8,"text":"явление","start":46,"end":53},{"i":9,"text":"Господа","start":54,"end":61},{"i":10,"text":"Иисуса","start":62,"end":68},{"i":11,"text":"с","start":69,"end":70},{"i":12,"text":"неба","start":71,"end":75},{"i":13,"text":"с","start":77,"end":78},{"i":14,"text":"Ангелами","start":79,"end":87},{"i":15,"text":"силы","start":88,"end":92},{"i":16,"text":"Его","start":93,"end":96}]},{"ref":"2thessalonians 1:8","n":8,"text":"в пламенеющем огне совершающего отмщение не познавшим Бога и не покоряющимся благовествованию Господа нашего Иисуса Христа,","words":[{"i":0,"text":"в","start":0,"end":1},{"i":1,"text":"пламенеющем","start":2,"end":13},{"i":2,"text":"огне","start":14,"end":18},{"i":3,"text":"совершающего","start":19,"end":31},{"i":4,"text":"отмщение","start":32,"end":40},{"i":5,"text":"не","start":41,"end":43},{"i":6,"text":"познавшим","start":44,"end":53},{"i":7,"text":"Бога","start":54,"end":58},{"i":8,"text":"и","start":59,"end":60},{"i":9,"text":"не","start":61,"end":63},{"i":10,"text":"покоряющимся","start":64,"end":76},{"i":11,"text":"благовествованию","start":77,"end":93},{"i":12,"text":"Господа","start":94,"end":101},{"i":13,"text":"нашего","start":102,"end":108},{"i":14,"text":"Иисуса","start":109,"end":115},{"i":15,"text":"Христа","start":116,"end":122}]},{"ref":"2thessalonians 1:9","n":9,"text":"которые подвергнутся наказанию, вечной погибели, от лица Господа и от славы могущества Его,","words":[{"i":0,"text":"которые","start":0,"end":7},{"i":1,"text":"подвергнутся","start":8,"end":20},{"i":2,"text":"наказанию","start":21,"end":30},{"i":3,"text":"вечной","start":32,"end":38},{"i":4,"text":"погибели","start":39,"end":47},{"i":5,"text":"от","start":49,"end":51},{"i":6,"text":"лица","start":52,"end":56},{"i":7,"text":"Господа","start":57,"end":64},{"i":8,"text":"и","start":65,"end":66},{"i":9,"text":"от","start":67,"end":69},{"i":10,"text":"славы","start":70,"end":75},{"i":11,"text":"могущества","start":76,"end":86},{"i":12,"text":"Его","start":87,"end":90}]},{"ref":"2thessalonians 1:10","n":10,"text":"когда Он приидет прославиться во святых Своих и явиться дивным в день оный во всех веровавших, так как вы поверили нашему св