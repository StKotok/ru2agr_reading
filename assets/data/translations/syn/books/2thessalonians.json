,"text":"погибающих","start":36,"end":46},{"i":6,"text":"за","start":47,"end":49},{"i":7,"text":"то","start":50,"end":52},{"i":8,"text":"что","start":54,"end":57},{"i":9,"text":"они","start":58,"end":61},{"i":10,"text":"не","start":62,"end":64},{"i":11,"text":"приняли","start":65,"end":72},{"i":12,"text":"любви","start":73,"end":78},{"i":13,"text":"истины","start":79,"end":85},{"i":14,"text":"для","start":86,"end":89},{"i":15,"text":"своего","start":90,"end":96},{"i":16,"text":"спасения","start":97,"end":105}]},{"ref":"2thessalonians 2:11","n":11,"text":"И за сие пошлет им Бог действие заблуждения, так что они будут верить лжи,","words":[{"i":0,"text":"И","start":0,"end":1},{"i":1,"text":"за","start":2,"end":4},{"i":2,"text":"сие","start":5,"end":8},{"i":3,"text":"пошлет","start":9,"end":15},{"i":4,"text":"им","start":16,"end":18},{"i":5,"text":"Бог","start":19,"end":22},{"i":6,"text":"действие","start":23,"end":31},{"i":7,"text":"заблуждения","start":32,"end":43},{"i":8,"text":"так","start":45,"end":48},{"i":9,"text":"что","start":49,"end":52},{"i":10,"text":"они","start":53,"end":56},{"i":11,"text":"будут","start":57,"end":62},{"i":12,"text":"верить","start":63,"end":69},{"i":13,"text":"лжи","start":70,"end":73}]},{"ref":"2thessalonians 2:12","n":12,"text":"да будут осуждены все, не веровавшие истине, но возлюбившие неправду.","words":[{"i":0,"text":"да","start":0,"end":2},{"i":1,"text":"будут","start":3,"end":8},{"i":2,"text":"осуждены","start":9,"end":17},{"i":3,"text":"все","start":18,"end":21},{"i":4,"text":"не","start":23,"end":25},{"i":5,"text":"веровавшие","start":26,"end":36},{"i":6,"text":"истине","start":37,"end":43},{"i":7,"text":"но","start":45,"end":47},{"i":8,"text":"возлюбившие","start":48,"end":59},{"i":9,"text":"неправду","start":60,"end":68}]},{"ref":"2thessalonians 2:13","n":13,"text":"Мы же всегда должны благодарить Бога за вас, возлюбленные Господом братия, что Бог от начала, через освящение Духа и веру истине, избрал вас ко спасению,","words":[{"i":0,"text":"Мы","start":0,"end":2},{"i":1,"text":"же","start":3,"end":5},{"i":2,"text":"всегда","start":6,"end":12},{"i":3,"text":"должны","start":13,"end":19},{"i":4,"text":"благодарить","start":20,"end":31},{"i":5,"text":"Бога","start":32,"end":36},{"i":6,"text":"за","start":37,"end":39},{"i":7,"text":"вас","start":40,"end":43},{"i":8,"text":"возлюбленные","start":45,"end":57},{"i":9,"text":"Господом","start":58,"end":66},{"i":10,"text":"братия","start":67,"end":73},{"i":11,"text":"что","start":75,"end":78},{"i":12,"text":"Бог","start":79,"end":82},{"i":13,"text":"от","start":83,"end":85},{"i":14,"text":"начала","start":86,"end":92},{"i":15,"text":"через","start":94,"end":99},{"i":16,"text":"освящение","start":100,"end":109},{"i":17,"text":"Духа","start":110,"end":114},{"i":18,"text":"и","start":115,"end":116},{"i":19,"text":"веру","start":117,"end":121},{"i":20,"text":"истине","start":122,"end":128},{"i":21,"text":"избрал","start":130,"end":136},{"i":22,"text":"вас","start":137,"end":140},{"i":23,"text":"ко","start":141,"end":143},{"i":24,"text":"спасению","start":144,"end":152}]},{"ref":"2thessalonians 2:14","n":14,"text":"к которому и призвал вас благовествованием нашим, для достижения славы Господа нашего Иисуса Христа.","words":[{"i":0,"text":"к","start":0,"end":1},{"i":1,"text":"которому","start":2,"end":10},{"i":2,"text":"и","start":11,"end":12},{"i":3,"text":"призвал","start":13,"end":20},{"i":4,"text":"вас","start":21,"end":24},{"i":5,"text":"благовествованием","start":25,"end":42},{"i":6,"text":"нашим","start":43,"end":48},{"i":7,"text":"для","start":50,"end":53},{"i":8,"text":"достижения","start":54,"end":64},{"i":9,"text":"славы","start":65,"end":70},{"i":10,"text":"Господа","start":71,"end":78},{"i":11,"text":"нашего","start":79,"end":85},{"i":12,"text":"Иисуса","start":86,"end":92},{"i":13,"text":"Христа","start":93,"end":99}]},{"ref":"2thessalonians 2:15","n":15,"text":"Итак, братия, стойте и держите предания, которым вы научены или словом или 