t":0,"end":3},{"i":1,"text":"I","start":4,"end":5},{"i":2,"text":"was","start":6,"end":9},{"i":3,"text":"overjoyed","start":10,"end":19},{"i":4,"text":"when","start":20,"end":24},{"i":5,"text":"the","start":25,"end":28},{"i":6,"text":"brothers","start":29,"end":37},{"i":7,"text":"came","start":38,"end":42},{"i":8,"text":"and","start":43,"end":46},{"i":9,"text":"testified","start":47,"end":56},{"i":10,"text":"about","start":57,"end":62},{"i":11,"text":"your","start":63,"end":67},{"i":12,"text":"devotion","start":68,"end":76},{"i":13,"text":"to","start":77,"end":79},{"i":14,"text":"the","start":80,"end":83},{"i":15,"text":"truth","start":84,"end":89},{"i":16,"text":"in","start":91,"end":93},{"i":17,"text":"which","start":94,"end":99},{"i":18,"text":"you","start":100,"end":103},{"i":19,"text":"continue","start":104,"end":112},{"i":20,"text":"to","start":113,"end":115},{"i":21,"text":"walk","start":116,"end":120}]},{"ref":"3john 1:4","n":4,"text":"I have no greater joy than to hear that my children are walking in the truth.","words":[{"i":0,"text":"I","start":0,"end":1},{"i":1,"text":"have","start":2,"end":6},{"i":2,"text":"no","start":7,"end":9},{"i":3,"text":"greater","start":10,"end":17},{"i":4,"text":"joy","start":18,"end":21},{"i":5,"text":"than","start":22,"end":26},{"i":6,"text":"to","start":27,"end":29},{"i":7,"text":"hear","start":30,"end":34},{"i":8,"text":"that","start":35,"end":39},{"i":9,"text":"my","start":40,"end":42},{"i":10,"text":"children","start":43,"end":51},{"i":11,"text":"are","start":52,"end":55},{"i":12,"text":"walking","start":56,"end":63},{"i":13,"text":"in","start":64,"end":66},{"i":14,"text":"the","start":67,"end":70},{"i":15,"text":"truth","start":71,"end":76}]},{"ref":"3john 1:5","n":5,"text":"Beloved, you are faithful in what you are doing for the brothers, and especially since they are strangers to you.","words":[{"i":0,"text":"Beloved","start":0,"end":7},{"i":1,"text":"you","start":9,"end":12},{"i":2,"text":"are","start":13,"end":16},{"i":3,"text":"faithful","start":17,"end":25},{"i":4,"text":"in","start":26,"end":28},{"i":5,"text":"what","start":29,"end":33},{"i":6,"text":"you","start":34,"end":37},{"i":7,"text":"are","start":38,"end":41},{"i":8,"text":"doing","start":42,"end":47},{"i":9,"text":"for","start":48,"end":51},{"i":10,"text":"the","start":52,"end":55},{"i":11,"text":"brothers","start":56,"end":64},{"i":12,"text":"and","start":66,"end":69},{"i":13,"text":"especially","start":70,"end":80},{"i":14,"text":"since","start":81,"end":86},{"i":15,"text":"they","start":87,"end":91},{"i":16,"text":"are","start":92,"end":95},{"i":17,"text":"strangers","start":96,"end":105},{"i":18,"text":"to","start":106,"end":108},{"i":19,"text":"you","start":109,"end":112}]},{"ref":"3john 1:6","n":6,"text":"They have testified to the church about your love. You will do well to send them on their way in a manner worthy of God.","words":[{"i":0,"text":"They","start":0,"end":4},{"i":1,"text":"have","start":5,"end":9},{"i":2,"text":"testified","start":10,"end":19},{"i":3,"text":"to","start":20,"end":22},{"i":4,"text":"the","start":23,"end":26},{"i":5,"text":"church","start":27,"end":33},{"i":6,"text":"about","start":34,"end":39},{"i":7,"text":"your","start":40,"end":44},{"i":8,"text":"love","start":45,"end":49},{"i":9,"text":"You","start":51,"end":54},{"i":10,"text":"will","start":55,"end":59},{"i":11,"text":"do","start":60,"end":62},{"i":12,"text":"well","start":63,"end":67},{"i":13,"text":"to","start":68,"end":70},{"i":14,"text":"send","start":71,"end":75},{"i":15,"text":"them","start":76,"end":80},{"i":16,"text":"on","start":81,"end":83},{"i":17,"text":"their","start":84,"end":89},{"i":18,"text":"way","start":90,"end":93},{"i":19,"text":"in","start":94,"end":96},{"i":20,"text":"a","start":97,"end":98},{"i":21,"text":"manner","start":99,"end":105},{"i":22,"text":"worthy","start":106,"end":112},{"i":23,"text":"of","start":113,"end":115},{"i":24,"text":"God","start":116,"end":119}]},{"ref":"3john 1:7","n":7,"text":"For they went out on behalf of the Name, accepting nothing from the Gentiles.","words":[{"i":0,"text":"For","start":0,"end":3},{"i":1,"text":"they","start":4,"end":8},{"i":2,"text":"went","start":9,"end":13},{"i":3,"text":"out","start":14,"end":17},{"i":4,"text":"on","start":18,"end":20},{"i":5,"text":"behalf","start":21,"end":27},{"i":6,"text":"of","start":28,"end":30},{"i":7,"text":"the","start":31,"end":34},{"i":8,"text":"Name","start":35,"end":39},{"i":9,"text":"accepting","start":41,"end":50},{"i":10,"text":"nothing","start":51,"end":58},{"i":11,"text":"from","start":59,"end":63},{"i":12,"text":"the","start":64,"end":67},{"i":13,"text":"Gentiles","start":68,"end":76}]},{"ref":"3john 1:8","n":8,"text":"Therefore we ought to support such men, so that we may be fellow workers for the truth.","words":[{"i":0,"text":"Therefore","start":0,"end":9},{"i":1,"text":"we","start":10,"end":12},{"i":2,"text":"ought","start":13,"end":18},{"i":3,"text":"to","start":19,"end":21},{"i":4,"text":"support","start":22,"end":29},{"i":5,"text":"such","start":30,"end":34},{"i":6,"text":"men","start":35,"end":38},{"i":7,"text":"so","start":40,"end":42},{"i":8,"text":"that","start":43,"end":47},{"i":9,"text":"we","start":48,"end":50},{"i":10,"text":"may","start":51,"end":54},{"i":11,"text":"be","start":55,"end":57},{"i":12,"text":"fellow","start":58,"end":64},{"i":13,"text":"workers","start":65,"end":72},{"i":14,"text":"for","start":73,"end":76},{"i":15,"text":"the","start":77,"end":80},{"i":16,"text":"truth","start":81,"end":86}]},{"ref":"3john 1:9","n":9,"text":"I have written to the church about this, but Diotrephes, who loves to be first, will not accept our instruction.","words":[{"i":0,"text":"I","start":0,"end":1},{"i":1,"text":"have","start":2,"end":6},{"i":2,"text":"written","start":7,"end":14},{"i":3,"text":"to","start":15,"end":17},{"i":4,"text":"the","start":18,"end":21},{"i":5,"text":"church","start":22,"end":28},{"i":6,"text":"about","start":29,"end":34},{"i":7,"text":"this