","start":153,"end":156},{"i":28,"text":"want","start":157,"end":161},{"i":29,"text":"to","start":162,"end":164},{"i":30,"text":"do","start":165,"end":167},{"i":31,"text":"so","start":168,"end":170},{"i":32,"text":"even","start":172,"end":176},{"i":33,"text":"putting","start":177,"end":184},{"i":34,"text":"them","start":185,"end":189},{"i":35,"text":"out","start":190,"end":193},{"i":36,"text":"of","start":194,"end":196},{"i":37,"text":"the","start":197,"end":200},{"i":38,"text":"church","start":201,"end":207}]},{"ref":"3john 1:11","n":11,"text":"Beloved, do not imitate what is evil, but what is good. The one who does good is of God; the one who does evil has not seen God.","words":[{"i":0,"text":"Beloved","start":0,"end":7},{"i":1,"text":"do","start":9,"end":11},{"i":2,"text":"not","start":12,"end":15},{"i":3,"text":"imitate","start":16,"end":23},{"i":4,"text":"what","start":24,"end":28},{"i":5,"text":"is","start":29,"end":31},{"i":6,"text":"evil","start":32,"end":36},{"i":7,"text":"but","start":38,"end":41},{"i":8,"text":"what","start":42,"end":46},{"i":9,"text":"is","start":47,"end":49},{"i":10,"text":"good","start":50,"end":54},{"i":11,"text":"The","start":56,"end":59},{"i":12,"text":"one","start":60,"end":63},{"i":13,"text":"who","start":64,"end":67},{"i":14,"text":"does","start":68,"end":72},{"i":15,"text":"good","start":73,"end":77},{"i":16,"text":"is","start":78,"end":80},{"i":17,"text":"of","start":81,"end":83},{"i":18,"text":"God","start":84,"end":87},{"i":19,"text":"the","start":89,"end":92},{"i":20,"text":"one","start":93,"end":96},{"i":21,"text":"who","start":97,"end":100},{"i":22,"text":"does","start":101,"end":105},{"i":23,"text":"evil","start":106,"end":110},{"i":24,"text":"has","start":111,"end":114},{"i":25,"text":"not","start":115,"end":118},{"i":26,"text":"seen","start":119,"end":123},{"i":27,"text":"God","start":124,"end":127}]},{"ref":"3john 1:12","n":12,"text":"Demetrius has received a good testimony from everyone, and from the truth itself. We also testify for him, and you know that our testimony is true.","words":[{"i":0,"text":"Demetrius","start":0,"end":9},{"i":1,"text":"has","start":10,"end":13},{"i":2,"text":"received","start":14,"end":22},{"i":3,"text":"a","start":23,"end":24},{"i":4,"text":"good","start":25,"end":29},{"i":5,"text":"testimony","start":30,"end":39},{"i":6,"text":"from","start":40,"end":44},{"i":7,"text":"everyone","start":45,"end":53},{"i":8,"text":"and","start":55,"end":58},{"i":9,"text":"from","start":59,"end":63},{"i":10,"text":"the","start":64,"end":67},{"i":11,"text":"truth","start":68,"end":73},{"i":12,"text":"itself","start":74,"end":80},{"i":13,"text":"We","start":82,"end":84},{"i":14,"text":"also","start":85,"end":89},{"i":15,"text":"testify","start":90,"end":97},{"i":16,"text":"for","start":98,"end":101},{"i":17,"text":"him","start":102,"end":105},{"i":18,"text":"and","start":107,"end":110},{"i":19,"text":"you","start":111,"end":114},{"i":20,"text":"know","start":115,"end":119},{"i":21,"text":"that","start":120,"end":124},{"i":22,"text":"our","start":125,"end":128},{"i":23,"text":"testimony","start":129,"end":138},{"i":24,"text":"is","start":139,"end":141},{"i":25,"text":"true","start":142,"end":146}]},{"ref":"3john 1:13","n":13,"text":"I have many things to write to you, but I would prefer not to do so with pen and ink.","words":[{"i":0,"text":"I","start":0,"end":1},{"i":1,"text":"have","start":2,"end":6},{"i":2,"text":"many","start":7,"end":11},{"i":3,"text":"things","start":12,"end":18},{"i":4,"text":"to","start":19,"end":21},{"i":5,"text":"write","start":22,"end":27},{"i":6,"text":"to","start":28,"end":30},{"i":7,"text":"you","start":31,"end":34},{"i":8,"text":"but","start":36,"end":39},{"i":9,"text":"I","start":40,"end":41},{"i":10,"text":"would","start":42,"end":47},{"i":11,"text":"prefer","start":48,"end":54},{"i":12,"text":"not","start":55,"end":58},{"i":13,"text":"to","start":59,"end":61},{"i":14,"text":"do","start":62,"end":64},{"i":15,"text":"so","start":65,"end":67},{"i":16,"text":"with","start":68,"end":72},{"i":17,"text":"pen","start":73,"end":76},{"i":18,"text":"and","start":77,"end":80},{"i":19,"text":"ink","start":81,"end":84}]},{"ref":"3john 1:14","n":14,"text":"Instead, I hope to see you soon and speak with you face to face. Peace to you. The friends here send you greetings. Greet each of our friends there by name.","words":[{"i":0,"text":"Instead","start":0,"end":7},{"i":1,"text":"I","start":9,"end":10},{"i":2,"text":"hope","start":11,"end":15},{"i":3,"text":"to","start":16,"end":18},{"i":4,"text":"see","start":19,"end":22},{"i":5,"text":"you","start":23,"end":26},{"i":6,"text":"soon","start":27,"end":31},{"i":7,"text":"and","start":32,"end":35},{"i":8,"text":"speak","start":36,"end":41},{"i":9,"text":"with","start":42,"end":46},{"i":10,"text":"you","start":47,"end":50},{"i":11,"text":"face","start":51,"end":55},{"i":12,"text":"to","start":56,"end":58},{"i":13,"text":"face","start":59,"end":63},{"i":14,"text":"Peace","start":65,"end":70},{"i":15,"text":"to","start":71,"end":73},{"i":16,"text":"you","start":74,"end":77},{"i":17,"text":"The","start":79,"end":82},{"i":18,"text":"friends","start":83,"end":90},{"i":19,"text":"here","start":91,"end":95},{"i":20,"text":"send","start":96,"end":100},{"i":21,"text":"you","start":101,"end":104},{"i":22,"text":"greetings","start":105,"end":114},{"i":23,"text":"Greet","start":116,"end":121},{"i":24,"text":"each","start":122,"end":126},{"i":25,"text":"of","start":127,"end":129},{"i":26,"text":"our","start":130,"end":133},{"i":27,"text":"friends","start":134,"end":141},{"i":28,"text":"there","start":142,"end":147},{"i":29,"text":"by","start":148,"end":150},{"i":30,"text":"name","start":151,"end":155}]}]}]}