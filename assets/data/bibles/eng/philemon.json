97}]},{"ref":"philemon 1:3","n":3,"text":"Grace and peace to you from God our Father and the Lord Jesus Christ.","words":[{"i":0,"text":"Grace","start":0,"end":5},{"i":1,"text":"and","start":6,"end":9},{"i":2,"text":"peace","start":10,"end":15},{"i":3,"text":"to","start":16,"end":18},{"i":4,"text":"you","start":19,"end":22},{"i":5,"text":"from","start":23,"end":27},{"i":6,"text":"God","start":28,"end":31},{"i":7,"text":"our","start":32,"end":35},{"i":8,"text":"Father","start":36,"end":42},{"i":9,"text":"and","start":43,"end":46},{"i":10,"text":"the","start":47,"end":50},{"i":11,"text":"Lord","start":51,"end":55},{"i":12,"text":"Jesus","start":56,"end":61},{"i":13,"text":"Christ","start":62,"end":68}]},{"ref":"philemon 1:4","n":4,"text":"I always thank my God, remembering you in my prayers,","words":[{"i":0,"text":"I","start":0,"end":1},{"i":1,"text":"always","start":2,"end":8},{"i":2,"text":"thank","start":9,"end":14},{"i":3,"text":"my","start":15,"end":17},{"i":4,"text":"God","start":18,"end":21},{"i":5,"text":"remembering","start":23,"end":34},{"i":6,"text":"you","start":35,"end":38},{"i":7,"text":"in","start":39,"end":41},{"i":8,"text":"my","start":42,"end":44},{"i":9,"text":"prayers","start":45,"end":52}]},{"ref":"philemon 1:5","n":5,"text":"because I hear about your faith in the Lord Jesus and your love for all the saints.","words":[{"i":0,"text":"because","start":0,"end":7},{"i":1,"text":"I","start":8,"end":9},{"i":2,"text":"hear","start":10,"end":14},{"i":3,"text":"about","start":15,"end":20},{"i":4,"text":"your","start":21,"end":25},{"i":5,"text":"faith","start":26,"end":31},{"i":6,"text":"in","start":32,"end":34},{"i":7,"text":"the","start":35,"end":38},{"i":8,"text":"Lord","start":39,"end":43},{"i":9,"text":"Jesus","start":44,"end":49},{"i":10,"text":"and","start":50,"end":53},{"i":11,"text":"your","start":54,"end":58},{"i":12,"text":"love","start":59,"end":63},{"i":13,"text":"for","start":64,"end":67},{"i":14,"text":"all","start":68,"end":71},{"i":15,"tex