,"end":1},{"i":1,"text":"am","start":2,"end":4},{"i":2,"text":"sending","start":5,"end":12},{"i":3,"text":"back","start":13,"end":17},{"i":4,"text":"to","start":18,"end":20},{"i":5,"text":"you","start":21,"end":24},{"i":6,"text":"him","start":25,"end":28},{"i":7,"text":"who","start":29,"end":32},{"i":8,"text":"is","start":33,"end":35},{"i":9,"text":"my","start":36,"end":38},{"i":10,"text":"very","start":39,"end":43},{"i":11,"text":"heart","start":44,"end":49}]},{"ref":"philemon 1:13","n":13,"text":"I would have liked to keep him with me, so that on your behalf he could minister to me in my chains for the gospel.","words":[{"i":0,"text":"I","start":0,"end":1},{"i":1,"text":"would","start":2,"end":7},{"i":2,"text":"have","start":8,"end":12},{"i":3,"text":"liked","start":13,"end":18},{"i":4,"text":"to","start":19,"end":21},{"i":5,"text":"keep","start":22,"end":26},{"i":6,"text":"him","start":27,"end":30},{"i":7,"text":"with","start":31,"end":35},{"i":8,"text":"me","start":36,"end":38},{"i":9,"text":"so","start":40,"end":42},{"i":10,"text":"that","start":43,"end":47},{"i":11,"text":"on","start":48,"end":50},{"i":12,"text":"your","start":51,"end":55},{"i":13,"text":"behalf","start":56,"end":62},{"i":14,"text":"he","start":63,"end":65},{"i":15,"text":"could","start":66,"end":71},{"i":16,"text":"minister","start":72,"end":80},{"i":17,"text":"to","start":81,"end":83},{"i":18,"text":"me","start":84,"end":86},{"i":19,"text":"in","start":87,"end":89},{"i":20,"text":"my","start":90,"end":92},{"i":21,"text":"chains","start":93,"end":99},{"i":22,"text":"for","start":100,"end":103},{"i":23,"text":"the","start":104,"end":107},{"i":24,"text":"gospel","start":108,"end":114}]},{"ref":"philemon 1:14","n":14,"text":"But I did not want to do anything without your consent, so that your goodness will not be out of compulsion, but by your own free will.","words":[{"i":0,"text":"But","start":0,"end":3},{"i":1,"text":"I","start":4,"end":5},{"i":2,"text":"did","start":6,"end":9},{"i":3,"text":