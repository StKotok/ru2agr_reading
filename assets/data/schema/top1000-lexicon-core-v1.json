{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "top1000-lexicon-core-v1",
  "title": "Top-1000 Lexicon Core (v1)",
  "description": "Language-neutral top-1000 lexicon core. NO hasAlignment, NO refs[], NO ru-fields.",
  "type": "object",
  "required": ["schema", "originalId", "items"],
  "properties": {
    "schema": { "const": "top1000-lexicon-core-v1" },
    "originalId": { "type": "string", "const": "sblgnt-macula" },
    "items": {
      "type": "array",
      "maxItems": 1000,
      "items": { "$ref": "#/$defs/item" }
    }
  },
  "$defs": {
    "item": {
      "type": "object",
      "required": [
        "lexemeKey", "maculaLexemeId", "lemma", "search", "translit",
        "strongs", "rank", "count", "verseCount", "pos", "isFunctionWord",
        "sourceGlosses", "forms", "firstRef", "domains"
      ],
      "properties": {
        "lexemeKey": { "type": "string" },
        "maculaLexemeId": { "type": "string" },
        "lemma": { "type": "string" },
        "search": { "type": "string", "description": "Search form (no accents)" },
        "translit": { "type": "string" },
        "strongs": { "type": "array", "items": { "type": "string" } },
        "rank": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "count": { "type": "integer", "description": "Token count" },
        "verseCount": { "type": "integer" },
        "pos": { "type": "string" },
        "isFunctionWord": { "type": "boolean" },
        "sourceGlosses": {
          "type": "object",
          "required": ["en"],
          "properties": {
            "en": { "type": "array", "items": { "type": "string" } }
          }
        },
        "forms": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["s", "count", "morph"],
            "properties": {
              "s": { "type": "string", "description": "Surface form" },
              "count": { "type": "integer" },
              "morph": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "firstRef": { "type": "string" },
        "domains": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    }
  }
}
