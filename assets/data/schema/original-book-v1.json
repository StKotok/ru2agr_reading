{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "original-book-v1",
  "title": "Original Book Pack (v1)",
  "description": "Compact nested projection of canonical MACULA tokens grouped by chapter/verse.",
  "type": "object",
  "required": ["schema", "originalId", "bookId", "title", "chapters"],
  "properties": {
    "schema": { "const": "original-book-v1" },
    "originalId": { "type": "string", "const": "sblgnt-macula" },
    "bookId": { "type": "string", "description": "e.g. john, matthew" },
    "title": { "type": "string", "description": "Greek book title" },
    "chapters": {
      "type": "array",
      "items": { "$ref": "#/$defs/chapter" }
    }
  },
  "$defs": {
    "chapter": {
      "type": "object",
      "required": ["n", "verses"],
      "properties": {
        "n": { "type": "integer", "minimum": 1 },
        "verses": {
          "type": "array",
          "items": { "$ref": "#/$defs/verse" }
        }
      }
    },
    "verse": {
      "type": "object",
      "required": ["ref", "n", "text", "tokens"],
      "properties": {
        "ref": { "type": "string", "description": "e.g. john 1:1" },
        "n": { "type": "integer" },
        "text": { "type": "string", "description": "Greek verse text" },
        "tokens": {
          "type": "array",
          "items": { "$ref": "#/$defs/token" }
        }
      }
    },
    "token": {
      "type": "object",
      "required": ["id", "i", "s", "lemma", "lexemeKey", "maculaLexemeId", "morph", "strongs", "fw"],
      "properties": {
        "id": { "type": "string", "description": "MACULA tokenId, e.g. n43001001001" },
        "i": { "type": "integer", "minimum": 1, "description": "1-based token index in verse" },
        "s": { "type": "string", "description": "Surface form (Greek word as in text)" },
        "lemma": { "type": "string", "description": "Greek lemma" },
        "lexemeKey": { "type": "string", "description": "App-level lexeme key" },
        "maculaLexemeId": { "type": "string", "description": "MACULA lexeme hash (provenance only)" },
        "morph": { "type": "string", "description": "Raw MACULA morphology code" },
        "strongs": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Strong's numbers as strings. Compound expressions preserved."
        },
        "fw": { "type": "boolean", "description": "Is function word" }
      }
    }
  }
}
