{"schema":"translation-book-v1","translationId":"syn","bookId":"philemon","title":"Послание к Филимону","short":"Флм","chapters":[{"n":1,"verses":[{"ref":"philemon 1:1","n":1,"text":"Павел, узник Иисуса Христа, и Тимофей брат, Филимону возлюбленному и сотруднику нашему,","words":[{"i":0,"text":"Павел","start":0,"end":5},{"i":1,"text":"узник","start":7,"end":12},{"i":2,"text":"Иисуса","start":13,"end":19},{"i":3,"text":"Христа","start":20,"end":26},{"i":4,"text":"и","start":28,"end":29},{"i":5,"text":"Тимофей","start":30,"end":37},{"i":6,"text":"брат","start":38,"end":42},{"i":7,"text":"Филимону","start":44,"end":52},{"i":8,"text":"возлюбленному","start":53,"end":66},{"i":9,"text":"и","start":67,"end":68},{"i":10,"text":"сотруднику","start":69,"end":79},{"i":11,"text":"нашему","start":80,"end":86}]},{"ref":"philemon 1:2","n":2,"text":"и Апфии, (сестре) возлюбленной, и Архиппу, сподвижнику нашему, и домашней твоей церкви:","words":[{"i":0,"text":"и","start":0,"end":1},{"i":1,"text":"Апфии","start":2,"end":7},{"i":2,"text":"сестре","start":10,"end":16},{"i":3,"text":"возлюбленной","start":18,"end":30},{"i":4,"text":"и","start":32,"end":33},{"i":5,"text":"Архиппу","start":34,"end":41},{"i":6,"text":"сподвижнику","start":43,"end":54},{"i":7,"text":"нашему","start":55,"end":61},{"i":8,"text":"и","start":63,"end":64},{"i":9,"text":"домашней","start":65,"end":73},{"i":10,"text":"твоей","start":74,"end":79},{"i":11,"text":"церкви","start":80,"end":86}]},{"ref":"philemon 1:3","n":3,"text":"благодать вам и мир от Бога Отца нашего и Господа Иисуса Христа.","words":[{"i":0,"text":"благодать","start":0,"end":9},{"i":1,"text":"вам","start":10,"end":13},{"i":2,"text":"и","start":14,"end":15},{"i":3,"text":"мир","start":16,"end":19},{"i":4,"text":"от","start":20,"end":22},{"i":5,"text":"Бога","start":23,"end":27},{"i":6,"text":"Отца","start":28,"end":32},{"i":7,"text":"нашего","start":33,"end":39},{"i":8,"text":"и","start":40,"end":41},{"i":9,"text":"Господа","start":42,"end":49},{"i":10,"text":"Иисуса","start":50,"end":56},{"i":11,"text":"Христа","start":57,"end":63}]},{"ref":"philemon 1:4","n":4,"text":"Благодарю Бога моего, всегда вспоминая о тебе в молитвах моих,","words":[{"i":0,"text":"Благодарю","start":0,"end":9},{"i":1,"text":"Бога","start":10,"end":14},{"i":2,"text":"моего","start":15,"end":20},{"i":3,"text":"всегда","start":22,"end":28},{"i":4,"text":"вспоминая","start":29,"end":38},{"i":5,"text":"о","start":39,"end":40},{"i":6,"text":"тебе","start":41,"end":45},{"i":7,"text":"в","start":46,"end":47},{"i":8,"text":"молитвах","start":48,"end":56},{"i":9,"text":"моих","start":57,"end":61}]},{"ref":"philemon 1:5","n":5,"text":"слыша о твоей любви и вере, которую имеешь к Господу Иисусу и ко всем святым,","words":[{"i":0,"text":"слыша","start":0,"end":5},{"i":1,"text":"о","start":6,"end":7},{"i":2,"text":"твоей","start":8,"end":13},{"i":3,"text":"любви","start":14,"end":19},{"i":4,"text":"и","start":20,"end":21},{"i":5,"text":"вере","start":22,"end":26},{"i":6,"text":"которую","start":28,"end":35},{"i":7,"text":"имеешь","start":36,"end":42},{"i":8,"text":"к","start":43,"end":44},{"i":9,"text":"Господу","start":45,"end":52},{"i":10,"text":"Иисусу","start":53,"end":59},{"i":11,"text":"и","start":60,"end":61},{"i":12,"text":"ко","start":62,"end":64},{"i":13,"text":"всем","start":65,"end":69},{"i":14,"text":"святым","start":70,"end":76}]},{"ref":"philemon 1:6","n":6,"text":"дабы общение веры твоей оказалось деятельным в познании всякого у вас добра во Христе Иисусе.","words":[{"i":0,"text":"дабы","start":0,"end":4},{"i":1,"text":"общение","start":5,"end":12},{"i":2,"text":"веры","start":13,"end":17},{"i":3,"text":"твоей","start":18,"end":23},{"i":4,"text":"оказалось","start":24,"end":33},{"i":5,"text":"деятельным","start":34,"end":44},{"i":6,"text":"в","start":45,"end":46},{"i":7,"text":"познании","start":47,"end":55},{"i":8,"text":"всякого","start":56,"end":63},{"i":9,"text":"у","start":64,"end":65},{"i":10,"text":"вас","start":66,"end":69},{"i":11,"text":"добра","start":70,"end":75},{"i":12,"text":"во","start":76,"end":78},{"i":13,"text":"Христе","start":79,"end":85},{"i":14,"text":"Иисусе","start":86,"end":92}]},{"ref":"philemon 1:7","n":7,"text":"Ибо мы имеем великую радость и утешение в любви твоей, потому что тобою, брат, успокоены сердца святых.","words":[{"i":0,"text":"Ибо","start":0,"end":3},{"i":1,"text":"мы","start":4,"end":6},{"i":2,"text":"имеем","start":7,"end":12},{"i":3,"text":"великую","start":13,"end":20},{"i":4,"text":"радость","start":21,"end":28},{"i":5,"text":"и","start":29,"end":30},{"i":6,"text":"утешение","start":31,"end":39},{"i":7,"text":"в","start":40,"end":41},{"i":8,"text":"любви","start":42,"end":47},{"i":9,"text":"твоей","start":48,"end":53},{"i":10,"text":"потому","start":55,"end":61},{"i":11,"text":"что","start":62,"end":65},{"i":12,"text":"тобою","start":66,"end":71},{"i":13,"text":"брат","start":73,"end":77},{"i":14,"text":"успокоены","start":79,"end":88},{"i":15,"text":"сердца","start":89,"end":95},{"i":16,"text":"святых","start":96,"end":102}]},{"ref":"philemon 1:8","n":8,"text":"Посему, имея великое во Христе дерзновение приказывать тебе, что должно,","words":[{"i":0,"text":"Посему","start":0,"end":6},{"i":1,"text":"имея","start":8,"end":12},{"i":2,"text":"великое","start":13,"end":20},{"i":3,"text":"во","start":21,"end":23},{"i":4,"text":"Христе","start":24,"end":30},{"i":5,"text":"дерзновение","start":31,"end":42},{"i":6,"text":"приказывать","start":43,"end":54},{"i":7,"text":"тебе","start":55,"end":59},{"i":8,"text":"что","start":61,"end":64},{"i":9,"text":"должно","start":65,"end":71}]},{"ref":"philemon 1:9","n":9,"text":"по любви лучше прошу, не иной кто, как я, Павел старец, а теперь и узник Иисуса Христа;","words":[{"i":0,"text":"по","start":0,"end":2},{"i":1,"text":"любви","start":3,"end":8},{"i":2,"text":"лучше","start":9,"end":14},{"i":3,"text":"прошу","start":15,"end":20},{"i":4,"text":"не","start":22,"end":24},{"i":5,"text":"иной","start":25,"end":29},{"i":6,"text":"кто","start":30,"end":33},{"i":7,"text":"как","start":35,"end":38},{"i":8,"text":"я","start":39,"end":40},{"i":9,"text":"Павел","start":42,"end":47},{"i":10,"text":"старец","start":48,"end":54},{"i":11,"text":"а","start":56,"end":57},{"i":12,"text":"теперь","start":58,"end":64},{"i":13,"text":"и","start":65,"end":66},{"i":14,"text":"узник","start":67,"end":72},{"i":15,"text":"Иисуса","start":73,"end":79},{"i":16,"text":"Христа","start":80,"end":86}]},{"ref":"philemon 1:10","n":10,"text":"прошу тебя о сыне моем Онисиме, которого родил я в узах моих:","words":[{"i":0,"text":"прошу","start":0,"end":5},{"i":1,"text":"тебя","start":6,"end":10},{"i":2,"text":"о","start":11,"end":12},{"i":3,"text":"сыне","start":13,"end":17},{"i":4,"text":"моем","start":18,"end":22},{"i":5,"text":"Онисиме","start":23,"end":30},{"i":6,"text":"которого","start":32,"end":40},{"i":7,"text":"родил","start":41,"end":46},{"i":8,"text":"я","start":47,"end":48},{"i":9,"text":"в","start":49,"end":50},{"i":10,"text":"узах","start":51,"end":55},{"i":11,"text":"моих","start":56,"end":60}]},{"ref":"philemon 1:11","n":11,"text":"он был некогда негоден для тебя, а теперь годен тебе и мне; я возвращаю его;","words":[{"i":0,"text":"он","start":0,"end":2},{"i":1,"text":"был","start":3,"end":6},{"i":2,"text":"некогда","start":7,"end":14},{"i":3,"text":"негоден","start":15,"end":22},{"i":4,"text":"для","start":23,"end":26},{"i":5,"text":"тебя","start":27,"end":31},{"i":6,"text":"а","start":33,"end":34},{"i":7,"text":"теперь","start":35,"end":41},{"i":8,"text":"годен","start":42,"end":47},{"i":9,"text":"тебе","start":48,"end":52},{"i":10,"text":"и","start":53,"end":54},{"i":11,"text":"мне","start":55,"end":58},{"i":12,"text":"я","start":60,"end":61},{"i":13,"text":"возвращаю","start":62,"end":71},{"i":14,"text":"его","start":72,"end":75}]},{"ref":"philemon 1:12","n":12,"text":"ты же прими его, как мое сердце.","words":[{"i":0,"text":"ты","start":0,"end":2},{"i":1,"text":"же","start":3,"end":5},{"i":2,"text":"прими","start":6,"end":11},{"i":3,"text":"его","start":12,"end":15},{"i":4,"text":"как","start":17,"end":20},{"i":5,"text":"мое","start":21,"end":24},{"i":6,"text":"сердце","start":25,"end":31}]},{"ref":"philemon 1:13","n":13,"text":"Я хотел при себе удержать его, дабы он вместо тебя послужил мне в узах за благовествование;","words":[{"i":0,"text":"Я","start":0,"end":1},{"i":1,"text":"хотел","start":2,"end":7},{"i":2,"text":"при","start":8,"end":11},{"i":3,"text":"себе","start":12,"end":16},{"i":4,"text":"удержать","start":17,"end":25},{"i":5,"text":"его","start":26,"end":29},{"i":6,"text":"дабы","start":31,"end":35},{"i":7,"text":"он","start":36,"end":38},{"i":8,"text":"вместо","start":39,"end":45},{"i":9,"text":"тебя","start":46,"end":50},{"i":10,"text":"послужил","start":51,"end":59},{"i":11,"text":"мне","start":60,"end":63},{"i":12,"text":"в","start":64,"end":65},{"i":13,"text":"узах","start":66,"end":70},{"i":14,"text":"за","start":71,"end":73},{"i":15,"text":"благовествование","start":74,"end":90}]},{"ref":"philemon 1:14","n":14,"text":"но без твоего согласия ничего не хотел сделать, чтобы доброе дело твое было не вынужденно, а добровольно.","words":[{"i":0,"text":"но","start":0,"end":2},{"i":1,"text":"без","start":3,"end":6},{"i":2,"text":"твоего","start":7,"end":13},{"i":3,"text":"согласия","start":14,"end":22},{"i":4,"text":"ничего","start":23,"end":29},{"i":5,"text":"не","start":30,"end":32},{"i":6,"text":"хотел","start":33,"end":38},{"i":7,"text":"сделать","start":39,"end":46},{"i":8,"text":"чтобы","start":48,"end":53},{"i":9,"text":"доброе","start":54,"end":60},{"i":10,"text":"дело","start":61,"end":65},{"i":11,"text":"твое","start":66,"end":70},{"i":12,"text":"было","start":71,"end":75},{"i":13,"text":"не","start":76,"end":78},{"i":14,"text":"вынужденно","start":79,"end":89},{"i":15,"text":"а","start":91,"end":92},{"i":16,"text":"добровольно","start":93,"end":104}]},{"ref":"philemon 1:15","n":15,"text":"Ибо, может быть, он для того на время отлучился, чтобы тебе принять его навсегда,","words":[{"i":0,"text":"Ибо","start":0,"end":3},{"i":1,"text":"может","start":5,"end":10},{"i":2,"text":"быть","start":11,"end":15},{"i":3,"text":"он","start":17,"end":19},{"i":4,"text":"для","start":20,"end":23},{"i":5,"text":"того","start":24,"end":28},{"i":6,"text":"на","start":29,"end":31},{"i":7,"text":"время","start":32,"end":37},{"i":8,"text":"отлучился","start":38,"end":47},{"i":9,"text":"чтобы","start":49,"end":54},{"i":10,"text":"тебе","start":55,"end":59},{"i":11,"text":"принять","start":60,"end":67},{"i":12,"text":"его","start":68,"end":71},{"i":13,"text":"навсегда","start":72,"end":80}]},{"ref":"philemon 1:16","n":16,"text":"не как уже раба, но выше раба, брата возлюбленного, особенно мне, а тем больше тебе, и по плоти и в Господе.","words":[{"i":0,"text":"не","start":0,"end":2},{"i":1,"text":"как","start":3,"end":6},{"i":2,"text":"уже","start":7,"end":10},{"i":3,"text":"раба","start":11,"end":15},{"i":4,"text":"но","start":17,"end":19},{"i":5,"text":"выше","start":20,"end":24},{"i":6,"text":"раба","start":25,"end":29},{"i":7,"text":"брата","start":31,"end":36},{"i":8,"text":"возлюбленного","start":37,"end":50},{"i":9,"text":"особенно","start":52,"end":60},{"i":10,"text":"мне","start":61,"end":64},{"i":11,"text":"а","start":66,"end":67},{"i":12,"text":"тем","start":68,"end":71},{"i":13,"text":"больше","start":72,"end":78},{"i":14,"text":"тебе","start":79,"end":83},{"i":15,"text":"и","start":85,"end":86},{"i":16,"text":"по","start":87,"end":89},{"i":17,"text":"плоти","start":90,"end":95},{"i":18,"text":"и","start":96,"end":97},{"i":19,"text":"в","start":98,"end":99},{"i":20,"text":"Господе","start":100,"end":107}]},{"ref":"philemon 1:17","n":17,"text":"Итак, если ты имеешь общение со мною, то прими его, как меня.","words":[{"i":0,"text":"Итак","start":0,"end":4},{"i":1,"text":"если","start":6,"end":10},{"i":2,"text":"ты","start":11,"end":13},{"i":3,"text":"имеешь","start":14,"end":20},{"i":4,"text":"общение","start":21,"end":28},{"i":5,"text":"со","start":29,"end":31},{"i":6,"text":"мною","start":32,"end":36},{"i":7,"text":"то","start":38,"end":40},{"i":8,"text":"прими","start":41,"end":46},{"i":9,"text":"его","start":47,"end":50},{"i":10,"text":"как","start":52,"end":55},{"i":11,"text":"меня","start":56,"end":60}]},{"ref":"philemon 1:18","n":18,"text":"Если же он чем обидел тебя, или должен, считай это на мне.","words":[{"i":0,"text":"Если","start":0,"end":4},{"i":1,"text":"же","start":5,"end":7},{"i":2,"text":"он","start":8,"end":10},{"i":3,"text":"чем","start":11,"end":14},{"i":4,"text":"обидел","start":15,"end":21},{"i":5,"text":"тебя","start":22,"end":26},{"i":6,"text":"или","start":28,"end":31},{"i":7,"text":"должен","start":32,"end":38},{"i":8,"text":"считай","start":40,"end":46},{"i":9,"text":"это","start":47,"end":50},{"i":10,"text":"на","start":51,"end":53},{"i":11,"text":"мне","start":54,"end":57}]},{"ref":"philemon 1:19","n":19,"text":"Я, Павел, написал моею рукою: я заплачу; не говорю тебе о том, что ты и самим собою мне должен.","words":[{"i":0,"text":"Я","start":0,"end":1},{"i":1,"text":"Павел","start":3,"end":8},{"i":2,"text":"написал","start":10,"end":17},{"i":3,"text":"моею","start":18,"end":22},{"i":4,"text":"рукою","start":23,"end":28},{"i":5,"text":"я","start":30,"end":31},{"i":6,"text":"заплачу","start":32,"end":39},{"i":7,"text":"не","start":41,"end":43},{"i":8,"text":"говорю","start":44,"end":50},{"i":9,"text":"тебе","start":51,"end":55},{"i":10,"text":"о","start":56,"end":57},{"i":11,"text":"том","start":58,"end":61},{"i":12,"text":"что","start":63,"end":66},{"i":13,"text":"ты","start":67,"end":69},{"i":14,"text":"и","start":70,"end":71},{"i":15,"text":"самим","start":72,"end":77},{"i":16,"text":"собою","start":78,"end":83},{"i":17,"text":"мне","start":84,"end":87},{"i":18,"text":"должен","start":88,"end":94}]},{"ref":"philemon 1:20","n":20,"text":"Так, брат, дай мне воспользоваться от тебя в Господе; успокой мое сердце в Господе.","words":[{"i":0,"text":"Так","start":0,"end":3},{"i":1,"text":"брат","start":5,"end":9},{"i":2,"text":"дай","start":11,"end":14},{"i":3,"text":"мне","start":15,"end":18},{"i":4,"text":"воспользоваться","start":19,"end":34},{"i":5,"text":"от","start":35,"end":37},{"i":6,"text":"тебя","start":38,"end":42},{"i":7,"text":"в","start":43,"end":44},{"i":8,"text":"Господе","start":45,"end":52},{"i":9,"text":"успокой","start":54,"end":61},{"i":10,"text":"мое","start":62,"end":65},{"i":11,"text":"сердце","start":66,"end":72},{"i":12,"text":"в","start":73,"end":74},{"i":13,"text":"Господе","start":75,"end":82}]},{"ref":"philemon 1:21","n":21,"text":"Надеясь на послушание твое, я написал к тебе, зная, что ты сделаешь и более, нежели говорю.","words":[{"i":0,"text":"Надеясь","start":0,"end":7},{"i":1,"text":"на","start":8,"end":10},{"i":2,"text":"послушание","start":11,"end":21},{"i":3,"text":"твое","start":22,"end":26},{"i":4,"text":"я","start":28,"end":29},{"i":5,"text":"написал","start":30,"end":37},{"i":6,"text":"к","start":38,"end":39},{"i":7,"text":"тебе","start":40,"end":44},{"i":8,"text":"зная","start":46,"end":50},{"i":9,"text":"что","start":52,"end":55},{"i":10,"text":"ты","start":56,"end":58},{"i":11,"text":"сделаешь","start":59,"end":67},{"i":12,"text":"и","start":68,"end":69},{"i":13,"text":"более","start":70,"end":75},{"i":14,"text":"нежели","start":77,"end":83},{"i":15,"text":"говорю","start":84,"end":90}]},{"ref":"philemon 1:22","n":22,"text":"А вместе приготовь для меня и помещение; ибо надеюсь, что по молитвам вашим я буду дарован вам.","words":[{"i":0,"text":"А","start":0,"end":1},{"i":1,"text":"вместе","start":2,"end":8},{"i":2,"text":"приготовь","start":9,"end":18},{"i":3,"text":"для","start":19,"end":22},{"i":4,"text":"меня","start":23,"end":27},{"i":5,"text":"и","start":28,"end":29},{"i":6,"text":"помещение","start":30,"end":39},{"i":7,"text":"ибо","start":41,"end":44},{"i":8,"text":"надеюсь","start":45,"end":52},{"i":9,"text":"что","start":54,"end":57},{"i":10,"text":"по","start":58,"end":60},{"i":11,"text":"молитвам","start":61,"end":69},{"i":12,"text":"вашим","start":70,"end":75},{"i":13,"text":"я","start":76,"end":77},{"i":14,"text":"буду","start":78,"end":82},{"i":15,"text":"дарован","start":83,"end":90},{"i":16,"text":"вам","start":91,"end":94}]},{"ref":"philemon 1:23","n":23,"text":"Приветствует тебя Епафрас, узник вместе со мною ради Христа Иисуса,","words":[{"i":0,"text":"Приветствует","start":0,"end":12},{"i":1,"text":"тебя","start":13,"end":17},{"i":2,"text":"Епафрас","start":18,"end":25},{"i":3,"text":"узник","start":27,"end":32},{"i":4,"text":"вместе","start":33,"end":39},{"i":5,"text":"со","start":40,"end":42},{"i":6,"text":"мною","start":43,"end":47},{"i":7,"text":"ради","start":48,"end":52},{"i":8,"text":"Христа","start":53,"end":59},{"i":9,"text":"Иисуса","start":60,"end":66}]},{"ref":"philemon 1:24","n":24,"text":"Марк, Аристарх, Димас, Лука, сотрудники мои.","words":[{"i":0,"text":"Марк","start":0,"end":4},{"i":1,"text":"Аристарх","start":6,"end":14},{"i":2,"text":"Димас","start":16,"end":21},{"i":3,"text":"Лука","start":23,"end":27},{"i":4,"text":"сотрудники","start":29,"end":39},{"i":5,"text":"мои","start":40,"end":43}]},{"ref":"philemon 1:25","n":25,"text":"Благодать Господа нашего Иисуса Христа со духом вашим. Аминь.","words":[{"i":0,"text":"Благодать","start":0,"end":9},{"i":1,"text":"Господа","start":10,"end":17},{"i":2,"text":"нашего","start":18,"end":24},{"i":3,"text":"Иисуса","start":25,"end":31},{"i":4,"text":"Христа","start":32,"end":38},{"i":5,"text":"со","start":39,"end":41},{"i":6,"text":"духом","start":42,"end":47},{"i":7,"text":"вашим","start":48,"end":53},{"i":8,"text":"Аминь","start":55,"end":60}]}]}]}