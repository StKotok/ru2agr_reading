{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "source-manifest-v1",
  "title": "Source Manifest (v1)",
  "description": "Provenance metadata for a committed source snapshot.",
  "type": "object",
  "required": ["schema", "id", "kind", "name", "url", "files", "license", "attribution", "fetchedAt"],
  "properties": {
    "schema": { "const": "source-manifest-v1" },
    "id": { "type": "string", "description": "Unique snapshot id, e.g. macula-greek-2026-06-17" },
    "kind": { "type": "string", "enum": ["original", "translation", "locale"] },
    "name": { "type": "string" },
    "url": { "type": "string", "description": "Source URL" },
    "ref": { "type": "string" },
    "commitOrTag": { "type": "string" },
    "corpus": { "type": "string" },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "sha256"],
        "properties": {
          "path": { "type": "string" },
          "sha256": { "type": "string" }
        }
      }
    },
    "license": { "type": "string" },
    "licenseTextPath": { "type": ["string", "null"] },
    "attribution": { "type": "string" },
    "fetchedAt": { "type": "string", "format": "date" },
    "notes": { "type": "string" }
  }
}
