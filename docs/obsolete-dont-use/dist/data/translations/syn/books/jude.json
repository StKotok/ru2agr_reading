{"schema":"translation-book-v1","translationId":"syn","bookId":"jude","title":"Послание Иуды","short":"Иуд","chapters":[{"n":1,"verses":[{"ref":"jude 1:1","n":1,"text":"Иуда, раб Иисуса Христа, брат Иакова, призванным, которые освящены Богом Отцем и сохранены Иисусом Христом:","words":[{"i":0,"text":"Иуда","start":0,"end":4},{"i":1,"text":"раб","start":6,"end":9},{"i":2,"text":"Иисуса","start":10,"end":16},{"i":3,"text":"Христа","start":17,"end":23},{"i":4,"text":"брат","start":25,"end":29},{"i":5,"text":"Иакова","start":30,"end":36},{"i":6,"text":"призванным","start":38,"end":48},{"i":7,"text":"которые","start":50,"end":57},{"i":8,"text":"освящены","start":58,"end":66},{"i":9,"text":"Богом","start":67,"end":72},{"i":10,"text":"Отцем","start":73,"end":78},{"i":11,"text":"и","start":79,"end":80},{"i":12,"text":"сохранены","start":81,"end":90},{"i":13,"text":"Иисусом","start":91,"end":98},{"i":14,"text":"Христом","start":99,"end":106}]},{"ref":"jude 1:2","n":2,"text":"милость вам и мир и любовь да умножатся.","words":[{"i":0,"text":"милость","start":0,"end":7},{"i":1,"text":"вам","start":8,"end":11},{"i":2,"text":"и","start":12,"end":13},{"i":3,"text":"мир","start":14,"end":17},{"i":4,"text":"и","start":18,"end":19},{"i":5,"text":"любовь","start":20,"end":26},{"i":6,"text":"да","start":27,"end":29},{"i":7,"text":"умножатся","start":30,"end":39}]},{"ref":"jude 1:3","n":3,"text":"Возлюбленные! имея все усердие писать вам об общем спасении, я почел за нужное написать вам увещание - подвизаться за веру, однажды преданную святым.","words":[{"i":0,"text":"Возлюбленные","start":0,"end":12},{"i":1,"text":"имея","start":14,"end":18},{"i":2,"text":"все","start":19,"end":22},{"i":3,"text":"усердие","start":23,"end":30},{"i":4,"text":"писать","start":31,"end":37},{"i":5,"text":"вам","start":38,"end":41},{"i":6,"text":"об","start":42,"end":44},{"i":7,"text":"общем","start":45,"end":50},{"i":8,"text":"спасении","start":51,"end":59},{"i":9,"text":"я","start":61,"end":62},{"i":10,"text":"почел","start":63,"end":68},{"i":11,"text":"за","start":69,"end":71},{"i":12,"text":"нужное","start":72,"end":78},{"i":13,"text":"написать","start":79,"end":87},{"i":14,"text":"вам","start":88,"end":91},{"i":15,"text":"увещание","start":92,"end":100},{"i":16,"text":"подвизаться","start":103,"end":114},{"i":17,"text":"за","start":115,"end":117},{"i":18,"text":"веру","start":118,"end":122},{"i":19,"text":"однажды","start":124,"end":131},{"i":20,"text":"преданную","start":132,"end":141},{"i":21,"text":"святым","start":142,"end":148}]},{"ref":"jude 1:4","n":4,"text":"Ибо вкрались некоторые люди, издревле предназначенные к сему осуждению, нечестивые, обращающие благодать Бога нашего в повод к распутству и отвергающиеся единого Владыки Бога и Господа нашего Иисуса Христа.","words":[{"i":0,"text":"Ибо","start":0,"end":3},{"i":1,"text":"вкрались","start":4,"end":12},{"i":2,"text":"некоторые","start":13,"end":22},{"i":3,"text":"люди","start":23,"end":27},{"i":4,"text":"издревле","start":29,"end":37},{"i":5,"text":"предназначенные","start":38,"end":53},{"i":6,"text":"к","start":54,"end":55},{"i":7,"text":"сему","start":56,"end":60},{"i":8,"text":"осуждению","start":61,"end":70},{"i":9,"text":"нечестивые","start":72,"end":82},{"i":10,"text":"обращающие","start":84,"end":94},{"i":11,"text":"благодать","start":95,"end":104},{"i":12,"text":"Бога","start":105,"end":109},{"i":13,"text":"нашего","start":110,"end":116},{"i":14,"text":"в","start":117,"end":118},{"i":15,"text":"повод","start":119,"end":124},{"i":16,"text":"к","start":125,"end":126},{"i":17,"text":"распутству","start":127,"end":137},{"i":18,"text":"и","start":138,"end":139},{"i":19,"text":"отвергающиеся","start":140,"end":153},{"i":20,"text":"единого","start":154,"end":161},{"i":21,"text":"Владыки","start":162,"end":169},{"i":22,"text":"Бога","start":170,"end":174},{"i":23,"text":"и","start":175,"end":176},{"i":24,"text":"Господа","start":177,"end":184},{"i":25,"text":"нашего","start":185,"end":191},{"i":26,"text":"Иисуса","start":192,"end":198},{"i":27,"text":"Христа","start":199,"end":205}]},{"ref":"jude 1:5","n":5,"text":"Я хочу напомнить вам, уже знающим это, что Господь, избавив народ из земли Египетской, потом неверовавших погубил,","words":[{"i":0,"text":"Я","start":0,"end":1},{"i":1,"text":"хочу","start":2,"end":6},{"i":2,"text":"напомнить","start":7,"end":16},{"i":3,"text":"вам","start":17,"end":20},{"i":4,"text":"уже","start":22,"end":25},{"i":5,"text":"знающим","start":26,"end":33},{"i":6,"text":"это","start":34,"end":37},{"i":7,"text":"что","start":39,"end":42},{"i":8,"text":"Господь","start":43,"end":50},{"i":9,"text":"избавив","start":52,"end":59},{"i":10,"text":"народ","start":60,"end":65},{"i":11,"text":"из","start":66,"end":68},{"i":12,"text":"земли","start":69,"end":74},{"i":13,"text":"Египетской","start":75,"end":85},{"i":14,"text":"потом","start":87,"end":92},{"i":15,"text":"неверовавших","start":93,"end":105},{"i":16,"text":"погубил","start":106,"end":113}]},{"ref":"jude 1:6","n":6,"text":"и ангелов, не сохранивших своего достоинства, но оставивших свое жилище, соблюдает в вечных узах, под мраком, на суд великого дня.","words":[{"i":0,"text":"и","start":0,"end":1},{"i":1,"text":"ангелов","start":2,"end":9},{"i":2,"text":"не","start":11,"end":13},{"i":3,"text":"сохранивших","start":14,"end":25},{"i":4,"text":"своего","start":26,"end":32},{"i":5,"text":"достоинства","start":33,"end":44},{"i":6,"text":"но","start":46,"end":48},{"i":7,"text":"оставивших","start":49,"end":59},{"i":8,"text":"свое","start":60,"end":64},{"i":9,"text":"жилище","start":65,"end":71},{"i":10,"text":"соблюдает","start":73,"end":82},{"i":11,"text":"в","start":83,"end":84},{"i":12,"text":"вечных","start":85,"end":91},{"i":13,"text":"узах","start":92,"end":96},{"i":14,"text":"под","start":98,"end":101},{"i":15,"text":"мраком","start":102,"end":108},{"i":16,"text":"на","start":110,"end":112},{"i":17,"text":"суд","start":113,"end":116},{"i":18,"text":"великого","start":117,"end":125},{"i":19,"text":"дня","start":126,"end":129}]},{"ref":"jude 1:7","n":7,"text":"Как Содом и Гоморра и окрестные города, подобно им блудодействовавшие и ходившие за иною плотию, подвергшись казни огня вечного, поставлены в пример, -","words":[{"i":0,"text":"Как","start":0,"end":3},{"i":1,"text":"Содом","start":4,"end":9},{"i":2,"text":"и","start":10,"end":11},{"i":3,"text":"Гоморра","start":12,"end":19},{"i":4,"text":"и","start":20,"end":21},{"i":5,"text":"окрестные","start":22,"end":31},{"i":6,"text":"города","start":32,"end":38},{"i":7,"text":"подобно","start":40,"end":47},{"i":8,"text":"им","start":48,"end":50},{"i":9,"text":"блудодействовавшие","start":51,"end":69},{"i":10,"text":"и","start":70,"end":71},{"i":11,"text":"ходившие","start":72,"end":80},{"i":12,"text":"за","start":81,"end":83},{"i":13,"text":"иною","start":84,"end":88},{"i":14,"text":"плотию","start":89,"end":95},{"i":15,"text":"подвергшись","start":97,"end":108},{"i":16,"text":"казни","start":109,"end":114},{"i":17,"text":"огня","start":115,"end":119},{"i":18,"text":"вечного","start":120,"end":127},{"i":19,"text":"поставлены","start":129,"end":139},{"i":20,"text":"в","start":140,"end":141},{"i":21,"text":"пример","start":142,"end":148}]},{"ref":"jude 1:8","n":8,"text":"так точно будет и с сими мечтателями, которые оскверняют плоть, отвергают начальства и злословят высокие власти.","words":[{"i":0,"text":"так","start":0,"end":3},{"i":1,"text":"точно","start":4,"end":9},{"i":2,"text":"будет","start":10,"end":15},{"i":3,"text":"и","start":16,"end":17},{"i":4,"text":"с","start":18,"end":19},{"i":5,"text":"сими","start":20,"end":24},{"i":6,"text":"мечтателями","start":25,"end":36},{"i":7,"text":"которые","start":38,"end":45},{"i":8,"text":"оскверняют","start":46,"end":56},{"i":9,"text":"плоть","start":57,"end":62},{"i":10,"text":"отвергают","start":64,"end":73},{"i":11,"text":"начальства","start":74,"end":84},{"i":12,"text":"и","start":85,"end":86},{"i":13,"text":"злословят","start":87,"end":96},{"i":14,"text":"высокие","start":97,"end":104},{"i":15,"text":"власти","start":105,"end":111}]},{"ref":"jude 1:9","n":9,"text":"Михаил Архангел, когда говорил с диаволом, споря о Моисеевом теле, не смел произнести укоризненного суда, но сказал: `да запретит тебе Господь.","words":[{"i":0,"text":"Михаил","start":0,"end":6},{"i":1,"text":"Архангел","start":7,"end":15},{"i":2,"text":"когда","start":17,"end":22},{"i":3,"text":"говорил","start":23,"end":30},{"i":4,"text":"с","start":31,"end":32},{"i":5,"text":"диаволом","start":33,"end":41},{"i":6,"text":"споря","start":43,"end":48},{"i":7,"text":"о","start":49,"end":50},{"i":8,"text":"Моисеевом","start":51,"end":60},{"i":9,"text":"теле","start":61,"end":65},{"i":10,"text":"не","start":67,"end":69},{"i":11,"text":"смел","start":70,"end":74},{"i":12,"text":"произнести","start":75,"end":85},{"i":13,"text":"укоризненного","start":86,"end":99},{"i":14,"text":"суда","start":100,"end":104},{"i":15,"text":"но","start":106,"end":108},{"i":16,"text":"сказал","start":109,"end":115},{"i":17,"text":"да","start":118,"end":120},{"i":18,"text":"запретит","start":121,"end":129},{"i":19,"text":"тебе","start":130,"end":134},{"i":20,"text":"Господь","start":135,"end":142}]},{"ref":"jude 1:10","n":10,"text":"А сии злословят то, чего не знают; что же по природе, как бессловесные животные, знают, тем растлевают себя.","words":[{"i":0,"text":"А","start":0,"end":1},{"i":1,"text":"сии","start":2,"end":5},{"i":2,"text":"злословят","start":6,"end":15},{"i":3,"text":"то","start":16,"end":18},{"i":4,"text":"чего","start":20,"end":24},{"i":5,"text":"не","start":25,"end":27},{"i":6,"text":"знают","start":28,"end":33},{"i":7,"text":"что","start":35,"end":38},{"i":8,"text":"же","start":39,"end":41},{"i":9,"text":"по","start":42,"end":44},{"i":10,"text":"природе","start":45,"end":52},{"i":11,"text":"как","start":54,"end":57},{"i":12,"text":"бессловесные","start":58,"end":70},{"i":13,"text":"животные","start":71,"end":79},{"i":14,"text":"знают","start":81,"end":86},{"i":15,"text":"тем","start":88,"end":91},{"i":16,"text":"растлевают","start":92,"end":102},{"i":17,"text":"себя","start":103,"end":107}]},{"ref":"jude 1:11","n":11,"text":"Горе им, потому что идут путем Каиновым, предаются обольщению мзды, как Валаам, и в упорстве погибают, как Корей.","words":[{"i":0,"text":"Горе","start":0,"end":4},{"i":1,"text":"им","start":5,"end":7},{"i":2,"text":"потому","start":9,"end":15},{"i":3,"text":"что","start":16,"end":19},{"i":4,"text":"идут","start":20,"end":24},{"i":5,"text":"путем","start":25,"end":30},{"i":6,"text":"Каиновым","start":31,"end":39},{"i":7,"text":"предаются","start":41,"end":50},{"i":8,"text":"обольщению","start":51,"end":61},{"i":9,"text":"мзды","start":62,"end":66},{"i":10,"text":"как","start":68,"end":71},{"i":11,"text":"Валаам","start":72,"end":78},{"i":12,"text":"и","start":80,"end":81},{"i":13,"text":"в","start":82,"end":83},{"i":14,"text":"упорстве","start":84,"end":92},{"i":15,"text":"погибают","start":93,"end":101},{"i":16,"text":"как","start":103,"end":106},{"i":17,"text":"Корей","start":107,"end":112}]},{"ref":"jude 1:12","n":12,"text":"Таковые бывают соблазном на ваших вечерях любви; пиршествуя с вами, без страха утучняют себя. Это безводные облака, носимые ветром; осенние деревья, бесплодные, дважды умершие, исторгнутые;","words":[{"i":0,"text":"Таковые","start":0,"end":7},{"i":1,"text":"бывают","start":8,"end":14},{"i":2,"text":"соблазном","start":15,"end":24},{"i":3,"text":"на","start":25,"end":27},{"i":4,"text":"ваших","start":28,"end":33},{"i":5,"text":"вечерях","start":34,"end":41},{"i":6,"text":"любви","start":42,"end":47},{"i":7,"text":"пиршествуя","start":49,"end":59},{"i":8,"text":"с","start":60,"end":61},{"i":9,"text":"вами","start":62,"end":66},{"i":10,"text":"без","start":68,"end":71},{"i":11,"text":"страха","start":72,"end":78},{"i":12,"text":"утучняют","start":79,"end":87},{"i":13,"text":"себя","start":88,"end":92},{"i":14,"text":"Это","start":94,"end":97},{"i":15,"text":"безводные","start":98,"end":107},{"i":16,"text":"облака","start":108,"end":114},{"i":17,"text":"носимые","start":116,"end":123},{"i":18,"text":"ветром","start":124,"end":130},{"i":19,"text":"осенние","start":132,"end":139},{"i":20,"text":"деревья","start":140,"end":147},{"i":21,"text":"бесплодные","start":149,"end":159},{"i":22,"text":"дважды","start":161,"end":167},{"i":23,"text":"умершие","start":168,"end":175},{"i":24,"text":"исторгнутые","start":177,"end":188}]},{"ref":"jude 1:13","n":13,"text":"свирепые морские волны, пенящиеся срамотами своими; звезды блуждающие, которым блюдется мрак тьмы на веки.","words":[{"i":0,"text":"свирепые","start":0,"end":8},{"i":1,"text":"морские","start":9,"end":16},{"i":2,"text":"волны","start":17,"end":22},{"i":3,"text":"пенящиеся","start":24,"end":33},{"i":4,"text":"срамотами","start":34,"end":43},{"i":5,"text":"своими","start":44,"end":50},{"i":6,"text":"звезды","start":52,"end":58},{"i":7,"text":"блуждающие","start":59,"end":69},{"i":8,"text":"которым","start":71,"end":78},{"i":9,"text":"блюдется","start":79,"end":87},{"i":10,"text":"мрак","start":88,"end":92},{"i":11,"text":"тьмы","start":93,"end":97},{"i":12,"text":"на","start":98,"end":100},{"i":13,"text":"веки","start":101,"end":105}]},{"ref":"jude 1:14","n":14,"text":"О них пророчествовал и Енох, седьмый от Адама, говоря: `се, идет Господь со тьмами святых Ангелов Своих -","words":[{"i":0,"text":"О","start":0,"end":1},{"i":1,"text":"них","start":2,"end":5},{"i":2,"text":"пророчествовал","start":6,"end":20},{"i":3,"text":"и","start":21,"end":22},{"i":4,"text":"Енох","start":23,"end":27},{"i":5,"text":"седьмый","start":29,"end":36},{"i":6,"text":"от","start":37,"end":39},{"i":7,"text":"Адама","start":40,"end":45},{"i":8,"text":"говоря","start":47,"end":53},{"i":9,"text":"се","start":56,"end":58},{"i":10,"text":"идет","start":60,"end":64},{"i":11,"text":"Господь","start":65,"end":72},{"i":12,"text":"со","start":73,"end":75},{"i":13,"text":"тьмами","start":76,"end":82},{"i":14,"text":"святых","start":83,"end":89},{"i":15,"text":"Ангелов","start":90,"end":97},{"i":16,"text":"Своих","start":98,"end":103}]},{"ref":"jude 1:15","n":15,"text":"сотворить суд над всеми и обличить всех между ними нечестивых во всех делах, которые произвело их нечестие, и во всех жестоких словах, которые произносили на Него нечестивые грешники.","words":[{"i":0,"text":"сотворить","start":0,"end":9},{"i":1,"text":"суд","start":10,"end":13},{"i":2,"text":"над","start":14,"end":17},{"i":3,"text":"всеми","start":18,"end":23},{"i":4,"text":"и","start":24,"end":25},{"i":5,"text":"обличить","start":26,"end":34},{"i":6,"text":"всех","start":35,"end":39},{"i":7,"text":"между","start":40,"end":45},{"i":8,"text":"ними","start":46,"end":50},{"i":9,"text":"нечестивых","start":51,"end":61},{"i":10,"text":"во","start":62,"end":64},{"i":11,"text":"всех","start":65,"end":69},{"i":12,"text":"делах","start":70,"end":75},{"i":13,"text":"которые","start":77,"end":84},{"i":14,"text":"произвело","start":85,"end":94},{"i":15,"text":"их","start":95,"end":97},{"i":16,"text":"нечестие","start":98,"end":106},{"i":17,"text":"и","start":108,"end":109},{"i":18,"text":"во","start":110,"end":112},{"i":19,"text":"всех","start":113,"end":117},{"i":20,"text":"жестоких","start":118,"end":126},{"i":21,"text":"словах","start":127,"end":133},{"i":22,"text":"которые","start":135,"end":142},{"i":23,"text":"произносили","start":143,"end":154},{"i":24,"text":"на","start":155,"end":157},{"i":25,"text":"Него","start":158,"end":162},{"i":26,"text":"нечестивые","start":163,"end":173},{"i":27,"text":"грешники","start":174,"end":182}]},{"ref":"jude 1:16","n":16,"text":"Это ропотники, ничем не довольные, поступающие по своим похотям (нечестиво и беззаконно); уста их произносят надутые слова; они оказывают лицеприятие для корысти.","words":[{"i":0,"text":"Это","start":0,"end":3},{"i":1,"text":"ропотники","start":4,"end":13},{"i":2,"text":"ничем","start":15,"end":20},{"i":3,"text":"не","start":21,"end":23},{"i":4,"text":"довольные","start":24,"end":33},{"i":5,"text":"поступающие","start":35,"end":46},{"i":6,"text":"по","start":47,"end":49},{"i":7,"text":"своим","start":50,"end":55},{"i":8,"text":"похотям","start":56,"end":63},{"i":9,"text":"нечестиво","start":65,"end":74},{"i":10,"text":"и","start":75,"end":76},{"i":11,"text":"беззаконно","start":77,"end":87},{"i":12,"text":"уста","start":90,"end":94},{"i":13,"text":"их","start":95,"end":97},{"i":14,"text":"произносят","start":98,"end":108},{"i":15,"text":"надутые","start":109,"end":116},{"i":16,"text":"слова","start":117,"end":122},{"i":17,"text":"они","start":124,"end":127},{"i":18,"text":"оказывают","start":128,"end":137},{"i":19,"text":"лицеприятие","start":138,"end":149},{"i":20,"text":"для","start":150,"end":153},{"i":21,"text":"корысти","start":154,"end":161}]},{"ref":"jude 1:17","n":17,"text":"Но вы, возлюбленные, помните предсказанное Апостолами Господа нашего Иисуса Христа.","words":[{"i":0,"text":"Но","start":0,"end":2},{"i":1,"text":"вы","start":3,"end":5},{"i":2,"text":"возлюбленные","start":7,"end":19},{"i":3,"text":"помните","start":21,"end":28},{"i":4,"text":"предсказанное","start":29,"end":42},{"i":5,"text":"Апостолами","start":43,"end":53},{"i":6,"text":"Господа","start":54,"end":61},{"i":7,"text":"нашего","start":62,"end":68},{"i":8,"text":"Иисуса","start":69,"end":75},{"i":9,"text":"Христа","start":76,"end":82}]},{"ref":"jude 1:18","n":18,"text":"Они говорили вам, что в последнее время появятся ругатели, поступающие по своим нечестивым похотям.","words":[{"i":0,"text":"Они","start":0,"end":3},{"i":1,"text":"говорили","start":4,"end":12},{"i":2,"text":"вам","start":13,"end":16},{"i":3,"text":"что","start":18,"end":21},{"i":4,"text":"в","start":22,"end":23},{"i":5,"text":"последнее","start":24,"end":33},{"i":6,"text":"время","start":34,"end":39},{"i":7,"text":"появятся","start":40,"end":48},{"i":8,"text":"ругатели","start":49,"end":57},{"i":9,"text":"поступающие","start":59,"end":70},{"i":10,"text":"по","start":71,"end":73},{"i