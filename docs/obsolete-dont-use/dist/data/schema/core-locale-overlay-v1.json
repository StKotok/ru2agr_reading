{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "core-locale-overlay-v1",
  "title": "Core Locale Overlay (v1)",
  "description": "Locale-specific match rules (ruMatches/ruExclude) for alignment generation.",
  "type": "object",
  "required": ["schema", "localeId", "items"],
  "properties": {
    "schema": { "const": "core-locale-overlay-v1" },
    "localeId": { "type": "string", "const": "ru" },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["lexemeKey", "pos", "ruMatches", "ruExclude", "refs"],
        "properties": {
          "lexemeKey": { "type": "string" },
          "pos": { "type": "string" },
          "ruMatches": { "type": "array", "items": { "type": "string" } },
          "ruExclude": { "type": "array", "items": { "type": "string" } },
          "refs": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": false
      }
    }
  }
}
