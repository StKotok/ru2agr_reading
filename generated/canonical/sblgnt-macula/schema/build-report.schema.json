{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BuildReport",
  "description": "MACULA pipeline build report",
  "type": "object",
  "properties": {
    "generatedAt": {
      "type": "string"
    },
    "summary": {
      "type": "object"
    },
    "coverage": {
      "type": "object"
    },
    "unknownValues": {
      "type": "object"
    },
    "problems": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sourceFiles": {
      "type": "object"
    }
  }
}